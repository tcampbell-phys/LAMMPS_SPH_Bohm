variable half_box_len equal 8.34803267196151/2.0

### simulation parameters:

variable time_step_length equal 1e-4
variable data_time_steps equal 0
variable dump_ts_freq equal 1
variable cutoff equal 5.0                                          # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style charge

variable al_seed equal 910
variable e_up_seed equal 707
variable e_down_seed equal 78

