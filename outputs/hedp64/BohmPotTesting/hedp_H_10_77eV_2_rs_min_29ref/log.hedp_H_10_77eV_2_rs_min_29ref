region bounding_region block 0.0 12.8997972795364 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 12.8997972795364 0.0 12.8997972795364 0.0 ${box_len}
region bounding_region block 0.0 12.8997972795364 0.0 12.8997972795364 0.0 12.8997972795364
timestep ${time_step_length}
timestep 0.00025

create_box 2 bounding_region
