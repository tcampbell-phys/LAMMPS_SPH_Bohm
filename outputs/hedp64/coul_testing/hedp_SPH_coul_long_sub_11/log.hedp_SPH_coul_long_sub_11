variable tfwhm equal 4.70964*1.2*5.95226431035528/(200^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_nopseudo_ph_sub
fix ele_dyn_wid electron dynamic_widths 1.2 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_nopseudo_ph_sub
