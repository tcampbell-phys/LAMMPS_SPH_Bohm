# increase number of allowed neighbours
neigh_modify one 10000

variable tag_ele_start equal ${num_ions}+1
variable tag_ele_start equal 200+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.2
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.2*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.2*11.9045286207106/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.2*11.9045286207106/(200^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_nopseudo_ph_sub
fix ele_dyn_wid electron dynamic_widths 1.2 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_nopseudo_ph_sub
fix ele_dyn_wid electron dynamic_widths 1.2 1 ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_nopseudo_ph_sub
fix ele_dyn_wid electron dynamic_widths 1.2 1 1 ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_nopseudo_ph_sub
fix ele_dyn_wid electron dynamic_widths 1.2 1 1 2.4 ${cutoff} ${type_avoid} coul/long/SPH_nopseudo_ph_sub
fix ele_dyn_wid electron dynamic_widths 1.2 1 1 2.4 11.6 ${type_avoid} coul/long/SPH_nopseudo_ph_sub
fix ele_dyn_wid electron dynamic_widths 1.2 1 1 2.4 11.6 1 coul/long/SPH_nopseudo_ph_sub

