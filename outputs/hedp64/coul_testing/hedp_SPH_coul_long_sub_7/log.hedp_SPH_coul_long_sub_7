pair_style hybrid/overlay sub_minoo 11.6 182307.042191 ${electron_amu} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub ${cutoff} 1.0 1 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style hybrid/overlay sub_minoo 11.6 182307.042191 0.00054857991 ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub ${cutoff} 1.0 1 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style hybrid/overlay sub_minoo 11.6 182307.042191 0.00054857991 1 ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub ${cutoff} 1.0 1 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
