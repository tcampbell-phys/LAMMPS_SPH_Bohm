pair_style hybrid/overlay sub_minoo 11.6 182307.042191 0.00054857991 1 201 coul/long/SPH_nopseudo_ph_sub 11.6 1.0 1 11.5045904353871 1 201

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph_sub
pair_coeff 2 2 sub_minoo

variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/11.6
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 0.258620689655172

fix all_nve all nve

velocity ion create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity ion create 182307.042191 ${ion_vel_seed} rot yes dist gaussian
velocity ion create 182307.042191 59292 rot yes dist gaussian

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 182307.042191 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 182307.042191 84504 rot yes dist gaussian

