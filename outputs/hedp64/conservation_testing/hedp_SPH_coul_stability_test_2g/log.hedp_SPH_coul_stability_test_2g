pair_style coul/long/SPH_nopseudo_ph_sub_thetacut ${cutoff_coul} ${cutoff} 1.0 10 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut 6.1305 ${cutoff} 1.0 10 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
