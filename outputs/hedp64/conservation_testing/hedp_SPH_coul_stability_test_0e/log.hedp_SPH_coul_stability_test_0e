pair_style coul/long/SPH_nopseudo_ph_sub ${cutoff_coul} 1.0 10 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 3.6654662949253 1.0 10 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
