# Set up each pair with the correct styles:

pair_coeff * *

# kspace
variable ewalds_parameter equal 4.0/${cutoff_coul}
variable ewalds_parameter equal 4.0/1.778
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
