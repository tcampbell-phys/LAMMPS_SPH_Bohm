fix write_all_momentum all ave/time 1 1 2 c_all_momentum[*] file /data/tcampbell/LAMMPS/SPH_Bohm/hedp_SPH_minoo_stability_test_2/all_momentum.out mode vector

# custom logfile output

thermo_modify lost warn
thermo ${dump_freq}
thermo 2
thermo_style custom step temp pe ke etotal press
