variable N_iter equal 2
variable mix_fact equal 1.0
variable type_avoid equal 10 #ensure ions are not included in SPH loops (must match ion type)

fix ele_dyn_wid electron dynamic_widths_com ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/cut/SPH_nopseudo_sub
