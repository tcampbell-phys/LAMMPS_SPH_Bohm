pair_style coul/long/SPH_nopseudo_ph_sub ${cutoff_coul} 1.0 10 ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 6.1090625440217 1.0 10 ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 6.1090625440217 1.0 10 3.05453127201085 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 6.1090625440217 1.0 10 3.05453127201085 1 1

# Set up each pair with the correct styles:

pair_coeff * *

# kspace
variable ewalds_parameter equal 3/${cutoff_coul}
variable ewalds_parameter equal 3/6.1090625440217
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
