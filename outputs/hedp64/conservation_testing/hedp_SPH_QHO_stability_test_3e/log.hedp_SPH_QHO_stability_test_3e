  2 by 2 by 2 MPI processor grid

create_atoms 1 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 1 random 1024 ${e_up_a_seed} NULL
create_atoms 1 random 1024 2 NULL
Created 1024 atoms
  create_atoms CPU = 0.000687423 secs
group electron type 1
1024 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 5.35722568359375e-07
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.0009765625
