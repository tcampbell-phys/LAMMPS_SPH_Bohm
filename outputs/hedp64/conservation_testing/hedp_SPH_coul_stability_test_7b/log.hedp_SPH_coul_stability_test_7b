
### SYSTEM PARAMETERS:

### physical parameters:

variable num_ions equal 2	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable elements_per_electron equal 3

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/3
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/3

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 2*${ion_charge}
variable num_electrons equal 2*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 2*${elements_per_electron}
variable num_electron_elements equal 2*3
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 2/2.0
variable box_len equal 3.556
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 3.556/2.0

variable dens_wid_const equal 0.91924
variable kernel_ave equal ${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable kernel_ave equal 0.91924*${box_len}/(${num_electron_elements}^(1/3))
variable kernel_ave equal 0.91924*3.556/(${num_electron_elements}^(1/3))
variable kernel_ave equal 0.91924*3.556/(6^(1/3))
variable tfwhm equal 4.70964*${kernel_ave}
variable tfwhm equal 4.70964*1.79889956279966
variable sigma_start equal ${kernel_ave}    # Start global packet width of electrons in bohr
variable sigma_start equal 1.79889956279966    

### simulation parameters:

variable time_step_length equal 0.5e-3
variable equi_time_steps equal 0
variable dump_freq equal 1
variable cutoff equal 4.243*${kernel_ave}                                  # cutoff for pairwise calculations
variable cutoff equal 4.243*1.79889956279966                                  
variable cutoff_coul equal ${half_box_len}
variable cutoff_coul equal 1.778

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH_CoM

# Pair style string selection

variable ion_seed equal 1
variable e_up_a_seed equal 2
variable e_up_b_seed equal 3
variable e_down_a_seed equal 4
variable e_down_b_seed equal 5

# thermostat parameters

variable ion_vel_seed equal 6
variable e_down_a_vel_seed equal 7
variable e_down_b_vel_seed equal 8
variable e_up_a_vel_seed equal 9
variable e_up_b_vel_seed equal 10

### NOTE - initialising particles from rest
variable vel_t equal 0.0

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 3.556 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 3.556 0.0 3.556 0.0 ${box_len}
region bounding_region block 0.0 3.556 0.0 3.556 0.0 3.556
timestep ${time_step_length}
timestep 0.0005

create_box 1 bounding_region
Created orthogonal box = (0 0 0) to (3.556 3.556 3.556)
  1 by 1 by 1 MPI processor grid

create_atoms 1 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 1 random 6 ${e_up_a_seed} NULL
create_atoms 1 random 6 2 NULL
Created 6 atoms
  create_atoms CPU = 0.000277313 secs
group electron type 1
6 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 0.00018285997
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.333333333333333
  6 settings made for charge

# increase number of allowed neighbours
neigh_modify one 10000

variable tag_ele_start equal 1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable N_iter equal 2
variable mix_fact equal 1.0
variable type_avoid equal 10 #ensure ions are not included in SPH loops (must match ion type)

fix ele_dyn_wid electron dynamic_widths_com ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff_coul} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff_coul} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 ${mix_fact} ${sigma_start} ${cutoff_coul} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 ${sigma_start} ${cutoff_coul} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 1.79889956279966 ${cutoff_coul} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 1.79889956279966 1.778 ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 1.79889956279966 1.778 3.556 ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 1.79889956279966 1.778 3.556 10 ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 1.79889956279966 1.778 3.556 10 2 ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 1.79889956279966 1.778 3.556 10 2 3 ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub_thetacut_test
fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 1.79889956279966 1.778 3.556 10 2 3 1 coul/long/SPH_nopseudo_ph_sub_thetacut_test

variable dummy_tfwhm equal 0.99*${cutoff_coul}
variable dummy_tfwhm equal 0.99*1.778

pair_style coul/long/SPH_nopseudo_ph_sub_thetacut_test ${cutoff_coul} ${cutoff_coul} 1.0 ${type_avoid} ${dummy_tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut_test 1.778 ${cutoff_coul} 1.0 ${type_avoid} ${dummy_tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut_test 1.778 1.778 1.0 ${type_avoid} ${dummy_tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut_test 1.778 1.778 1.0 10 ${dummy_tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut_test 1.778 1.778 1.0 10 1.76022 ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut_test 1.778 1.778 1.0 10 1.76022 3 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut_test 1.778 1.778 1.0 10 1.76022 3 1

# Set up each pair with the correct styles:

pair_coeff * *

# kspace
variable ewalds_parameter equal 3/${cutoff_coul}
variable ewalds_parameter equal 3/1.778
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 1.68728908886389

fix all_nve all nve
velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 7 rot yes dist gaussian

compute all_momentum all momentum

fix write_all_momentum all ave/time 1 1 ${dump_freq} c_all_momentum[*] file /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/all_momentum.out mode vector
fix write_all_momentum all ave/time 1 1 1 c_all_momentum[*] file /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/all_momentum.out mode vector
fix write_all_momentum all ave/time 1 1 1 c_all_momentum[*] file /data/tcampbell/LAMMPS/SPH_Bohm/hedp_SPH_coul_stability_test_7b/all_momentum.out mode vector

# custom logfile output

thermo_modify lost warn
thermo ${dump_freq}
thermo 1
thermo_style custom step temp pe ke etotal press
