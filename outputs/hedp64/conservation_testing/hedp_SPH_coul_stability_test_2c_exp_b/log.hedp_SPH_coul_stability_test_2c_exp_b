dump 1 electron custom ${dump_freq} /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/SPH_mass_vel.dump id mass vx vy vz
dump 1 electron custom 2 /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/SPH_mass_vel.dump id mass vx vy vz
dump 1 electron custom 2 /data/tcampbell/LAMMPS/SPH_Bohm/hedp_SPH_coul_stability_test_2c_exp_b/SPH_mass_vel.dump id mass vx vy vz

run ${equi_time_steps}
