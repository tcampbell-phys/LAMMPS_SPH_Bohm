create_atoms 1 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 1 random 2 ${e_up_a_seed} NULL
create_atoms 1 random 2 2 NULL
Created 2 atoms
  create_atoms CPU = 0.000270709 secs
group electron type 1
2 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 0.000274289955
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.5
