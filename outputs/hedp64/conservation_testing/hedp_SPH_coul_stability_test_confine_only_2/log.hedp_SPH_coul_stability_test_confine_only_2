fix Bohm_Pot electron dynamic_widths_com 0.91924 2 1 0.648570012147606 2.75188256154229 1000.0 1 82 64 1 confine

pair_style confine ${confine_strength} ${cutoff} 0.0 ${elements_per_electron}
pair_style confine 0.255 ${cutoff} 0.0 ${elements_per_electron}
pair_style confine 0.255 2.75188256154229 0.0 ${elements_per_electron}
pair_style confine 0.255 2.75188256154229 0.0 64

# Set up each pair with the correct styles:

pair_coeff * *

fix all_nve all nve

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 7 rot yes dist gaussian

