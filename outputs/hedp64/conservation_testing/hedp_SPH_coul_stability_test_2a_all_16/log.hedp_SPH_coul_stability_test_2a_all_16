fix ele_dyn_wid electron dynamic_widths_com 0.91924 2 1 0.648570012147606 3.05453127201085 ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} coul/long/SPH_nopseudo_ph_sub
