
### SYSTEM PARAMETERS:

### physical parameters:

variable num_ions equal 82	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable elements_per_electron equal 64

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/64
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/64

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 82*${ion_charge}
variable num_electrons equal 82*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 82*${elements_per_electron}
variable num_electron_elements equal 82*64
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 82/2.0
variable box_len equal 12.261
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 12.261/2.0

variable dens_wid_const equal 0.91924
variable kernel_ave equal ${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable kernel_ave equal 0.91924*${box_len}/(${num_electron_elements}^(1/3))
variable kernel_ave equal 0.91924*12.261/(${num_electron_elements}^(1/3))
variable kernel_ave equal 0.91924*12.261/(5248^(1/3))
variable tfwhm equal 4.70964*${kernel_ave}
variable tfwhm equal 4.70964*0.648570012147606
variable sigma_start equal ${kernel_ave}    # Start global packet width of electrons in bohr
variable sigma_start equal 0.648570012147606    

### simulation parameters:

variable time_step_length equal 0.5e-3
variable equi_time_steps equal 2e3
variable dump_freq equal 2
variable cutoff equal 4.243*${kernel_ave}                                  # cutoff for pairwise calculations
variable cutoff equal 4.243*0.648570012147606                                  
variable cutoff_coul equal 1.0*${tfwhm}
variable cutoff_coul equal 1.0*3.05453127201085

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH_CoM

# Pair style string selection

variable ion_seed equal 1
variable e_up_a_seed equal 2
variable e_up_b_seed equal 3
variable e_down_a_seed equal 4
variable e_down_b_seed equal 5

# thermostat parameters

variable ion_vel_seed equal 6
variable e_down_a_vel_seed equal 7
variable e_down_b_vel_seed equal 8
variable e_up_a_vel_seed equal 9
variable e_up_b_vel_seed equal 10

### NOTE - initialising particles from rest
variable vel_t equal 0.0

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 12.261 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 12.261 0.0 12.261 0.0 ${box_len}
region bounding_region block 0.0 12.261 0.0 12.261 0.0 12.261
timestep ${time_step_length}
timestep 0.0005

create_box 1 bounding_region
Created orthogonal box = (0 0 0) to (12.261 12.261 12.261)
  2 by 2 by 2 MPI processor grid

create_atoms 1 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 1 random 5248 ${e_up_a_seed} NULL
create_atoms 1 random 5248 2 NULL
Created 5248 atoms
  create_atoms CPU = 0.00120163 secs
group electron type 1
5248 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 8.57156109375e-06
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.015625
  5248 settings made for charge

# increase number of allowed neighbours
neigh_modify one 10000

variable tag_ele_start equal 1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

