pair_style coul/long/SPH_nopseudo_ph_sub ${cutoff_coul} 1.0 10 ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 5.49815628961953 1.0 10 ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 5.49815628961953 1.0 10 3.05453127201085 1 ${tag_ele_start}
