pair_style coul/long/SPH_nopseudo_ph_sub ${cutoff_coul} 1.0 10 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 3.05455524577108 1.0 10 ${tfwhm} ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 3.05455524577108 1.0 10 3.05455524577108 ${elements_per_electron} ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 3.05455524577108 1.0 10 3.05455524577108 64 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub 3.05455524577108 1.0 10 3.05455524577108 64 1

# Set up each pair with the correct styles:

pair_coeff * *

# kspace
variable ewalds_parameter equal 3/${cutoff_coul}
variable ewalds_parameter equal 3/3.05455524577108
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 0.982139708932549

fix all_nve all nve
velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 7 rot yes dist gaussian

compute all_momentum all momentum

fix write_all_momentum all ave/time 1 1 ${dump_freq} c_all_momentum[*] file /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/all_momentum.out mode vector
