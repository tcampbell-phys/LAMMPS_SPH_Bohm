pair_style coul/long/SPH_nopseudo_ph_sub_thetacut ${cutoff_coul} ${cutoff} 1.0 ${type_avoid} ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut 1.778 ${cutoff} 1.0 ${type_avoid} ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut 1.778 1.37603784767677 1.0 ${type_avoid} ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut 1.778 1.37603784767677 1.0 10 ${tfwhm} 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut 1.778 1.37603784767677 1.0 10 1.52737282322235 1 ${tag_ele_start}
pair_style coul/long/SPH_nopseudo_ph_sub_thetacut 1.778 1.37603784767677 1.0 10 1.52737282322235 1 1

# Set up each pair with the correct styles:

pair_coeff * *

# kspace
variable ewalds_parameter equal 3.5/${cutoff_coul}
variable ewalds_parameter equal 3.5/1.778
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 1.96850393700787

fix all_nve all nve
velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 7 rot yes dist gaussian

compute all_momentum all momentum

fix write_all_momentum all ave/time 1 1 ${dump_freq} c_all_momentum[*] file /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/all_momentum.out mode vector
