pair_style coul/long/SPH_nopseudo_ph_sub 3.6654662949253 1.0 10 3.05455524577108 64 1

# Set up each pair with the correct styles:

pair_coeff * *

# kspace
variable ewalds_parameter equal 3/${cutoff_coul}
variable ewalds_parameter equal 3/3.6654662949253
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
