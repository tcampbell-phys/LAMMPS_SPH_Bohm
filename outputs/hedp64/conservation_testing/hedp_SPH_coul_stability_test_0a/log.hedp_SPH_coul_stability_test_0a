fix all_nve all nve
velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 7 rot yes dist gaussian

compute all_momentum all momentum

fix write_all_momentum all ave/time 1 1 ${dump_freq} c_all_momentum[*] file /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/all_momentum.out mode vector
