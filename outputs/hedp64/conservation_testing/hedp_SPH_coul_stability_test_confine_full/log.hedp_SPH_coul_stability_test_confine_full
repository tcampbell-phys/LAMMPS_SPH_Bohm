dump 1 electron custom 2 /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/SPH_mass_vel.dump id mass vx vy vz
dump 1 electron custom 2 /data/tcampbell/LAMMPS/SPH_Bohm/hedp_SPH_coul_stability_test_confine_full/SPH_mass_vel.dump id mass vx vy vz

