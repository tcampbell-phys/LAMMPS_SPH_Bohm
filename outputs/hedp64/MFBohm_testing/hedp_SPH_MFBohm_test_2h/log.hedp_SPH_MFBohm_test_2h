fix ele_dyn_wid electron dynamic_widths_com_MF 1.2 1 1 1.3 6.632 7.6573113412363 10 ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.2 1 1 1.3 6.632 7.6573113412363 10 20 ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.2 1 1 1.3 6.632 7.6573113412363 10 20 20 ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.2 1 1 1.3 6.632 7.6573113412363 10 20 20 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.2 1 1 1.3 6.632 7.6573113412363 10 20 20 1 bohm_SPH_dynamic_Mocz_MF

# Set up each pair with the correct styles:

pair_coeff * *

fix all_nve all nve

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 7 rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# custom logfile output

thermo_style custom step temp pe ke etotal press

# modify logfile output

