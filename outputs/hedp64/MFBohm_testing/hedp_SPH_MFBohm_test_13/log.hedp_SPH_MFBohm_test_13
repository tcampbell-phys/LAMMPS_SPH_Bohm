
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 10.77	         # temperature in Ev
variable ion_density equal 0.044545217  		# Density in # per bohr^3
variable num_ions equal 50	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.3                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 80

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/80
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/80

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 50*${ion_charge}
variable num_electrons equal 50*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 50*${elements_per_electron}
variable num_electron_elements equal 50*80
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 50/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 25/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*10.77
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (50/${ion_density})^(1/3)
variable box_len equal (50/0.044545217)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 10.3925704002019/2.0

variable confine_strength equal 0.1       # set strength of qudratic confinement potential for SPH elements belonging to the same electron

### simulation parameters:

variable time_step_length equal 0.25e-3
variable block_time_steps equal 1e3
variable CoM_check_time_steps equal 200
variable dump_freq equal 1
variable cutoff equal 4.0                                  # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH_CoM

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_MF

variable ion_seed equal 1
variable e_up_a_seed equal 2
variable e_up_b_seed equal 3
variable e_down_a_seed equal 4
variable e_down_b_seed equal 5

# thermostat parameters

variable ion_vel_seed equal 6
variable e_down_a_vel_seed equal 7
variable e_down_b_vel_seed equal 8
variable e_up_a_vel_seed equal 9
variable e_up_b_vel_seed equal 10

variable i_temp_damping equal ${time_step_length}*100
variable i_temp_damping equal 0.00025*100
variable e_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal 0.00025*100

### NOTE - initialising particles from rest
variable vel_t equal 0.0*${temptouse}
variable vel_t equal 0.0*124980.703017

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 5000
variable rdf_measurement_time_gap equal 10

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 10.3925704002019 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 10.3925704002019 0.0 10.3925704002019 0.0 ${box_len}
region bounding_region block 0.0 10.3925704002019 0.0 10.3925704002019 0.0 10.3925704002019
timestep ${time_step_length}
timestep 0.00025

create_box 1 bounding_region
Created orthogonal box = (0 0 0) to (10.3926 10.3926 10.3926)
  1 by 2 by 2 MPI processor grid

create_atoms 1 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 1 random 4000 ${e_up_a_seed} NULL
create_atoms 1 random 4000 2 NULL
Created 4000 atoms
  create_atoms CPU = 0.00119765 secs
group electron type 1
4000 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 6.857248875e-06
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.0125
  4000 settings made for charge

# increase number of allowed neighbours
neigh_modify one 10000

variable tag_ele_start equal 1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*10.3925704002019/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*10.3925704002019/(4000^(1/3))
variable type_avoid equal 10 #ensure ions are not included in SPH loops (must match ion type)

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF ${cutoff} ${gamma_factor} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 ${gamma_factor} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 1822.888483 ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 1822.888483 80 ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 1822.888483 80 1 confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 1822.888483 80 1 confine 0.1 ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 1822.888483 80 1 confine 0.1 4 ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 1822.888483 80 1 confine 0.1 4 10.3925704002019 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 4 1822.888483 80 1 confine 0.1 4 10.3925704002019 80

fix ele_dyn_wid electron dynamic_widths_com_MF ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 4 ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 4 10.3925704002019 ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 4 10.3925704002019 10 ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 4 10.3925704002019 10 50 ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 4 10.3925704002019 10 50 80 ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 4 10.3925704002019 10 50 80 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 4 10.3925704002019 10 50 80 1 bohm_SPH_dynamic_Mocz_MF

# Set up each pair with the correct styles:

pair_coeff * * ${pair_name}
pair_coeff * * bohm_SPH_dynamic_Mocz_MF
pair_coeff * * confine

fix all_nve all nve

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 0 7 rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# custom logfile output

thermo_style custom step temp pe ke etotal press

# modify logfile output

# Minimize energy

min_style cg
minimize 1.0e-4 1.0e-5 50 50
