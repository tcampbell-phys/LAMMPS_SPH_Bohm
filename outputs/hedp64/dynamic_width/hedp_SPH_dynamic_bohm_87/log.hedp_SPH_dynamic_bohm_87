pair_style bohm_SPH_dynamic_Mocz 8.9 1

# Set up each pair with the correct styles:

pair_coeff * *

variable ewalds_parameter equal 4.242640687/${box_len}
variable ewalds_parameter equal 4.242640687/17.9852911819934

