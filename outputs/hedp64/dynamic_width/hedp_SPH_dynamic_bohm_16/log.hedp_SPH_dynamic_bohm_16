variable dens_wid_const equal 1.3
variable N_iter equal 3
variable mix_fact equal 0.25

fix all_dyn_wid all dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${pair_name}
