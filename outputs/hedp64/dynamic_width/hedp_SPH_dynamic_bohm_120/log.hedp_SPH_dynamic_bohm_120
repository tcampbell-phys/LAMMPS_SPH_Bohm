
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 3.5		                                        # Temperature in eV
variable al_solid_density equal 0.00899                             # Density in # per bohr^3
variable compression equal 1.912
variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable ion_density equal 1.912*${al_solid_density}  		
variable ion_density equal 1.912*0.00899  		
variable num_ions equal 250	                                        # Number of ions
variable ion_charge equal 3			                                # Average charge/ionization
variable ion_amu equal 26.982	                                # Atomic mass of ion
# variable ion_amu equal 1.0
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.5                                         # Start global packet width of electrons in bohr

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 250*${ion_charge}
variable num_electrons equal 250*3
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 750/2.0
variable temptouse equal 11604*${temp}
variable temptouse equal 11604*3.5
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (250/${ion_density})^(1/3)
variable box_len equal (250/0.01718888)^(1/3)
