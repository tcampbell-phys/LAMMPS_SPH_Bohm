region bounding_region block 0.0 24.409795611996 0.0 24.409795611996 0.0 ${box_len}
region bounding_region block 0.0 24.409795611996 0.0 24.409795611996 0.0 24.409795611996
timestep ${time_step_length}
timestep 0.001

create_box 3 bounding_region
