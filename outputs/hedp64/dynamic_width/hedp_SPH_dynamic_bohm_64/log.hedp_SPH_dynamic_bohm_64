fix all_nve all nve

velocity e_down create ${vel_t} ${e_down_vel_seed} rot yes dist gaussian
velocity e_down create 0 ${e_down_vel_seed} rot yes dist gaussian
velocity e_down create 0 83671 rot yes dist gaussian

velocity e_up create ${vel_t} ${e_up_vel_seed} rot yes dist gaussian
velocity e_up create 0 ${e_up_vel_seed} rot yes dist gaussian
velocity e_up create 0 76665 rot yes dist gaussian

