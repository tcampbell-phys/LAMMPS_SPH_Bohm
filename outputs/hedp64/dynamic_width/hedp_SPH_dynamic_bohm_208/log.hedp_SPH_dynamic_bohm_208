variable tfwhm equal 4.70964*1.1*30.7544153151853/(1500^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/long/SPH_ph ${cutoff} 1.0 1 ${pseudo_key} ${ion_charge} ${tfwhm}
pair_style hybrid/overlay bohm_SPH_dynamic ${cutoff} ${gamma_factor} coul/long/SPH_ph ${cutoff} 1.0 1 ${pseudo_key} ${ion_charge} ${tfwhm}
pair_style hybrid/overlay bohm_SPH_dynamic 15 ${gamma_factor} coul/long/SPH_ph ${cutoff} 1.0 1 ${pseudo_key} ${ion_charge} ${tfwhm}
pair_style hybrid/overlay bohm_SPH_dynamic 15 1 coul/long/SPH_ph ${cutoff} 1.0 1 ${pseudo_key} ${ion_charge} ${tfwhm}
pair_style hybrid/overlay bohm_SPH_dynamic 15 1 coul/long/SPH_ph 15 1.0 1 ${pseudo_key} ${ion_charge} ${tfwhm}
pair_style hybrid/overlay bohm_SPH_dynamic 15 1 coul/long/SPH_ph 15 1.0 1 0 ${ion_charge} ${tfwhm}
pair_style hybrid/overlay bohm_SPH_dynamic 15 1 coul/long/SPH_ph 15 1.0 1 0 3 ${tfwhm}
pair_style hybrid/overlay bohm_SPH_dynamic 15 1 coul/long/SPH_ph 15 1.0 1 0 3 13.9184471614616

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_ph
pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic
pair_coeff 2 3 ${pair_name}
pair_coeff 2 3 bohm_SPH_dynamic
pair_coeff 3 3 ${pair_name}
pair_coeff 3 3 bohm_SPH_dynamic

# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/15
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 0.2

fix ele_dyn_wid electrons dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electrons dynamic_widths 1.1 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electrons dynamic_widths 1.1 1 ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
