comm_modify vel yes

variable bitmap_N equal 15

variable pseudo_key equal 3

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/cut/SPH ${cutoff} 1.0 1 ${pseudo_key} ${ion_charge}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor} coul/cut/SPH ${cutoff} 1.0 1 ${pseudo_key} ${ion_charge}
