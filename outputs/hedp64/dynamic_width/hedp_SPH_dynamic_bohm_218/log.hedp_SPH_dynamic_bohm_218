pair_style hybrid/overlay filinovt ${cutoff} ${temptouse} ${electron_amu} filinovs ${cutoff} ${temptouse} ${electron_amu}
pair_style hybrid/overlay filinovt 2 ${temptouse} ${electron_amu} filinovs ${cutoff} ${temptouse} ${electron_amu}
