pair_style coul/long/SPH_ph 15 1.0 1 0 3 ${tfwhm}
pair_style coul/long/SPH_ph 15 1.0 1 0 3 13.9184471614616

# Set up each pair with the correct styles:

pair_coeff * *

# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/15
