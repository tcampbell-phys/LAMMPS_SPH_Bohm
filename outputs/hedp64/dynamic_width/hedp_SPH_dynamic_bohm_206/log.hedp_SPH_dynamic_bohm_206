region bounding_region block 0.0 30.7544153151853 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 30.7544153151853 0.0 30.7544153151853 0.0 ${box_len}
region bounding_region block 0.0 30.7544153151853 0.0 30.7544153151853 0.0 30.7544153151853
timestep ${time_step_length}
timestep 0.001

create_box 3 bounding_region
