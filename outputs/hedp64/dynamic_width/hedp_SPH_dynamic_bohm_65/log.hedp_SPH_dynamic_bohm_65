region bounding_region block 0.0 15.9692120129979 0.0 15.9692120129979 0.0 ${box_len}
region bounding_region block 0.0 15.9692120129979 0.0 15.9692120129979 0.0 15.9692120129979
timestep ${time_step_length}
timestep 0.001

