fix all_nve all nve

velocity e_down create ${vel_t} ${e_down_vel_seed} rot yes dist gaussian
velocity e_down create 40614 ${e_down_vel_seed} rot yes dist gaussian
velocity e_down create 40614 83671 rot yes dist gaussian

