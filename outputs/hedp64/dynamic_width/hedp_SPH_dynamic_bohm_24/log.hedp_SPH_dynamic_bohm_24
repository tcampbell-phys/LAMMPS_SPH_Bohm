
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 3.5		                                        # Temperature in eV
variable al_solid_density equal 0.00899                             # Density in # per bohr^3
variable compression equal 1.912
variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable ion_density equal 1.912*${al_solid_density}  		
variable ion_density equal 1.912*0.00899  		
variable num_ions equal 2	                                        # Number of ions
variable ion_charge equal 3			                                # Average charge/ionization
variable ion_amu equal 26.982		                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.5                                         # Start global packet width of electrons in bohr

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 2*${ion_charge}
variable num_electrons equal 2*3
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 6/2.0
variable temptouse equal 11604*${temp}
variable temptouse equal 11604*3.5
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (2/${ion_density})^(1/3)
variable box_len equal (2/0.01718888)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 4.8819591223992/2.0

### simulation parameters:

variable time_step_length equal 1e-2
variable data_time_steps equal 2
variable dump_ts_freq equal 1
variable cutoff equal 4.0                                          # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton off
boundary p p p
atom_style SPH

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable al_seed equal 910
variable e_up_seed equal 707
variable e_down_seed equal 78

# thermostat parameters

variable al_vel_seed equal 7389
variable e_down_vel_seed equal 83671
variable e_up_vel_seed equal 76665

variable i_temp_damping equal ${time_step_length}*1000
variable i_temp_damping equal 0.01*1000

variable alpha_mass equal 200.0
variable exp_cutoff equal 20.0
variable mu equal 0.64125                                           # ensure chemical potential matches with physical parameters

### NOTE - initialising particles from rest
variable vel_t equal ${temptouse}
variable vel_t equal 40614

