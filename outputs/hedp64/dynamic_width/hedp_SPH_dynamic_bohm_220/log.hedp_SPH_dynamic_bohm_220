pair_style minoo ${cutoff} ${temptouse} ${electron_amu}
pair_style minoo 2 ${temptouse} ${electron_amu}
pair_style minoo 2 40614 ${electron_amu}
pair_style minoo 2 40614 0.00054857991

# Set up each pair with the correct styles:

pair_coeff * *

fix all_nve all nve

# fix fermi_thermostat electrons fermi_nvt_no_cons ${temptouse} ${box_len} ${alpha_mass} ${electron_amu} ${exp_cutoff} ${mu}

### Thermostatting

# fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}

velocity e_up create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity e_up create 40614 ${ion_vel_seed} rot yes dist gaussian
velocity e_up create 40614 7389 rot yes dist gaussian

velocity e_down_a create ${vel_t} ${e_down_vel_seed} rot yes dist gaussian
velocity e_down_a create 40614 ${e_down_vel_seed} rot yes dist gaussian
velocity e_down_a create 40614 83671 rot yes dist gaussian

velocity e_down_b create ${vel_t} ${e_up_vel_seed} rot yes dist gaussian
velocity e_down_b create 40614 ${e_up_vel_seed} rot yes dist gaussian
velocity e_down_b create 40614 76665 rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# Compute group temperatures for output in logfile

compute e_up_temp e_up temp

compute e_down_a_temp e_down_a temp

compute e_down_b_temp e_down_b temp

# Compute group KEs for output in logfile

compute e_up_ke e_up ke

compute e_down_a_ke e_down_a ke

compute e_down_b_ke e_down_b ke

# custom logfile output

thermo_style custom step temp c_e_up_temp c_e_down_a_temp c_e_down_b_temp pe ke etotal press

# Minimize energy

#min_style cg
#minimize 1.0e-4 1.0e-5 1000 10000

reset_timestep 0

# Check forces

variable rhi equal 19.36
variable rlo equal 1.001e-2
variable write_N equal 1936

