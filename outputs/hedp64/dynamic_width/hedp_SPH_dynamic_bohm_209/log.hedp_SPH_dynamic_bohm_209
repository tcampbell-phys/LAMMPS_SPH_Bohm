fix ele_dyn_wid electrons dynamic_widths 1.1 1 0.5 2.5 15 1 ${pair_name}
fix ele_dyn_wid electrons dynamic_widths 1.1 1 0.5 2.5 15 1 bohm_SPH_dynamic

### Thermostatting

fix all_nve all nve

velocity ion create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity ion create 40614 ${ion_vel_seed} rot yes dist gaussian
velocity ion create 40614 7389 rot yes dist gaussian

velocity e_down create ${vel_t} ${e_down_vel_seed} rot yes dist gaussian
velocity e_down create 40614 ${e_down_vel_seed} rot yes dist gaussian
