variable half_box_len equal 22.6600469486822/2.0

### simulation parameters:

variable time_step_length equal 1.0e-2
variable data_time_steps equal 10
variable dump_ts_freq equal 1
variable cutoff equal 15.0                                          # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
