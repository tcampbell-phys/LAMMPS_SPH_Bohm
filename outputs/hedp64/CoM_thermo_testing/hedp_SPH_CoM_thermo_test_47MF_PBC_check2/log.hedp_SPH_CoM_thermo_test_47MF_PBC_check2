  create_atoms CPU = 0.00050847 secs
group electron type 1
768 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 2.85718703125e-06
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.00520833333333333
