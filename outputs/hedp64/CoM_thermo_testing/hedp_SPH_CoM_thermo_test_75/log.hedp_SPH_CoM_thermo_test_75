fix ele_dyn_wid electron dynamic_widths 1.3 1 1 1.3 12 ${type_avoid} confine_fixed
fix ele_dyn_wid electron dynamic_widths 1.3 1 1 1.3 12 10 confine_fixed

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} confine_fixed ${confine_strength} ${cutoff} ${half_box_len} ${half_box_len} ${half_box_len}
