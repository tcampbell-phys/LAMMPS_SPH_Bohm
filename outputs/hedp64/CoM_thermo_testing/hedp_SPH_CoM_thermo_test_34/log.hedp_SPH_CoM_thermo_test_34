fix ele_dyn_wid electron dynamic_widths 1.3 1 1 1.3 12 ${type_avoid} confine_fixed
fix ele_dyn_wid electron dynamic_widths 1.3 1 1 1.3 12 10 confine_fixed

pair_style confine_fixed ${confine_strength} ${cutoff} ${half_box_len} ${half_box_len} ${half_box_len}
pair_style confine_fixed 9.64453125e-05 ${cutoff} ${half_box_len} ${half_box_len} ${half_box_len}
pair_style confine_fixed 9.64453125e-05 12 ${half_box_len} ${half_box_len} ${half_box_len}
pair_style confine_fixed 9.64453125e-05 12 6 ${half_box_len} ${half_box_len}
pair_style confine_fixed 9.64453125e-05 12 6 6 ${half_box_len}
pair_style confine_fixed 9.64453125e-05 12 6 6 6

# Set up each pair with the correct styles:

pair_coeff * *

fix all_nve all nve
velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 7 rot yes dist gaussian

