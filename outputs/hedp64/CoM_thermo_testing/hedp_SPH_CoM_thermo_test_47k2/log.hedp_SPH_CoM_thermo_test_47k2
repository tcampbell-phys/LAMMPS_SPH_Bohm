variable tfwhm equal 4.70964*0.4*16/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*0.4*16/(256^(1/3))
variable type_avoid equal 10 #ensure ions are not included in SPH loops (must match ion type)

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} confine_fixed
