
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 10.77	         # temperature in Ev
variable ion_density equal 0.044545217  		# Density in # per bohr^3
variable num_ions equal 4	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.3                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 128

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/128
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/128

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 4*${ion_charge}
variable num_electrons equal 4*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 4*${elements_per_electron}
variable num_electron_elements equal 4*128
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 4/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 2/2.0
# variable temptouse equal 11604.5221*${temp}
variable temptouse equal 100
# variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal 16.00
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 16/2.0

variable confine_strength equal 0.007812500111898954/${elements_per_electron}       # set strength of qudratic confinement potential for SPH elements belonging to the same electron
variable confine_strength equal 0.007812500111898954/128       

### simulation parameters:

variable time_step_length equal 0.25e-3
variable equi_time_steps equal 4e4
variable buff_time_steps equal 2e3
variable CoM_check_time_steps equal 2e2
variable dump_freq equal 1
variable cutoff equal 8.0                                     # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH_CoM

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_MF

variable ion_seed equal 1
variable e_up_a_seed equal 2
variable e_up_b_seed equal 3
variable e_down_a_seed equal 4
variable e_down_b_seed equal 5

# thermostat parameters

variable ion_vel_seed equal 6
variable e_down_a_vel_seed equal 7
variable e_down_b_vel_seed equal 8
variable e_up_a_vel_seed equal 9
variable e_up_b_vel_seed equal 10

variable i_temp_damping equal ${time_step_length}*100
variable i_temp_damping equal 0.00025*100
variable e_temp_damping equal ${time_step_length}*500
variable e_temp_damping equal 0.00025*500

### NOTE - initialising particles from rest
variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*100

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 5000
variable rdf_measurement_time_gap equal 10

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 16 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 16 0.0 16 0.0 ${box_len}
region bounding_region block 0.0 16 0.0 16 0.0 16
timestep ${time_step_length}
timestep 0.00025

create_box 1 bounding_region
Created orthogonal box = (0 0 0) to (16 16 16)
  1 by 2 by 2 MPI processor grid

create_atoms 1 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 1 random 512 ${e_up_a_seed} NULL
create_atoms 1 random 512 2 NULL
Created 512 atoms
  create_atoms CPU = 0.000605942 secs
group electron type 1
512 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 4.285780546875e-06
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.0078125
  512 settings made for charge

# increase number of allowed neighbours
neigh_modify one 10000

variable tag_ele_start equal 1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*16/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*16/(512^(1/3))
variable type_avoid equal 10 #ensure ions are not included in SPH loops (must match ion type)

fix ele_dyn_wid electron dynamic_widths_com_MF ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 8 ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 8 16 ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 8 16 10 ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 8 16 10 4 ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 8 16 10 4 128 ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 8 16 10 4 128 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com_MF 1.3 1 1 1.3 8 16 10 4 128 1 bohm_SPH_dynamic_Mocz_MF

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF ${cutoff} ${gamma_factor} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 ${gamma_factor} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 1822.888483 ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 1822.888483 128 ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 1822.888483 128 1 confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 1822.888483 128 1 confine 6.10351571242106e-05 ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 1822.888483 128 1 confine 6.10351571242106e-05 8 ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 1822.888483 128 1 confine 6.10351571242106e-05 8 16 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_MF 8 1822.888483 128 1 confine 6.10351571242106e-05 8 16 128

# Set up each pair with the correct styles:

pair_coeff * * confine
pair_coeff * * ${pair_name}
pair_coeff * * bohm_SPH_dynamic_Mocz_MF

fix all_nve all nve
velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 7 rot yes dist gaussian

# custom logfile output

thermo_style custom step temp pe ke etotal press

# modify logfile output

reset_timestep 0

thermo_modify lost warn
thermo 10
