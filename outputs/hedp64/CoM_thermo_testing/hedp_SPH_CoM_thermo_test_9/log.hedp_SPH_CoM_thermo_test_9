fix ele_dyn_wid electron dynamic_widths_com 1.2 1 1 1.3 8 16.4971771859341 ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} confine
fix ele_dyn_wid electron dynamic_widths_com 1.2 1 1 1.3 8 16.4971771859341 10 ${num_electrons} ${elements_per_electron} ${tag_ele_start} confine
