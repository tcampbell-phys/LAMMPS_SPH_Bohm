# Set up each pair with the correct styles:

pair_coeff * * confine
pair_coeff * * ${pair_name}
pair_coeff * * bohm_SPH_dynamic_Mocz

fix all_nve all nve

# fix all_nvt_CoM all nvt_CoM temp_CoM ${temptouse} ${temptouse} ${e_temp_damping} ${elements_per_electron} ${num_electrons} ${tag_ele_start} ${electron_amu}

# fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}

