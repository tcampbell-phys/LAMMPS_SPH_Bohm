pair_style hybrid/overlay sub_minoo 8 ${temptouse} ${electron_amu} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay sub_minoo 8 124980.703017 ${electron_amu} ${elements_per_electron} ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
