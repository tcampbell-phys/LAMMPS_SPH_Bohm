pair_style hybrid/overlay sub_minoo 8 124980.703017 0.00054857991 8 ${tag_ele_start} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay sub_minoo 8 124980.703017 0.00054857991 8 1 confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay sub_minoo 8 124980.703017 0.00054857991 8 1 confine 0.2 ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay sub_minoo 8 124980.703017 0.00054857991 8 1 confine 0.2 8 ${box_len} ${elements_per_electron}
pair_style hybrid/overlay sub_minoo 8 124980.703017 0.00054857991 8 1 confine 0.2 8 16.4971771859341 ${elements_per_electron}
pair_style hybrid/overlay sub_minoo 8 124980.703017 0.00054857991 8 1 confine 0.2 8 16.4971771859341 8

# Set up each pair with the correct styles:

pair_coeff * * sub_minoo
pair_coeff * * confine

fix all_nvt_CoM all nvt temp_CoM ${temptouse} ${temptouse} ${e_temp_damping} ${elements_per_electron} ${num_electrons} ${tag_ele_start}
fix all_nvt_CoM all nvt temp_CoM 124980.703017 ${temptouse} ${e_temp_damping} ${elements_per_electron} ${num_electrons} ${tag_ele_start}
fix all_nvt_CoM all nvt temp_CoM 124980.703017 124980.703017 ${e_temp_damping} ${elements_per_electron} ${num_electrons} ${tag_ele_start}
fix all_nvt_CoM all nvt temp_CoM 124980.703017 124980.703017 0.025 ${elements_per_electron} ${num_electrons} ${tag_ele_start}
fix all_nvt_CoM all nvt temp_CoM 124980.703017 124980.703017 0.025 8 ${num_electrons} ${tag_ele_start}
fix all_nvt_CoM all nvt temp_CoM 124980.703017 124980.703017 0.025 8 200 ${tag_ele_start}
fix all_nvt_CoM all nvt temp_CoM 124980.703017 124980.703017 0.025 8 200 1

# fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 124980.703017 ${e_down_a_vel_seed} rot yes dist gaussian
