  create_atoms CPU = 0.000736917 secs
group electron type 1
1600 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 6.857248875e-05
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.125
  1600 settings made for charge

# increase number of allowed neighbours
neigh_modify one 10000

variable tag_ele_start equal 1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.2
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.2*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.2*16.4971771859341/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.2*16.4971771859341/(1600^(1/3))
variable type_avoid equal 10 #ensure ions are not included in SPH loops (must match ion type)

fix ele_dyn_wid electron dynamic_widths_com ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} confine
fix ele_dyn_wid electron dynamic_widths_com 1.2 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} confine
fix ele_dyn_wid electron dynamic_widths_com 1.2 1 ${mix_fact} ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} confine
fix ele_dyn_wid electron dynamic_widths_com 1.2 1 1 ${sigma_start} ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} confine
fix ele_dyn_wid electron dynamic_widths_com 1.2 1 1 1.3 ${cutoff} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} confine
