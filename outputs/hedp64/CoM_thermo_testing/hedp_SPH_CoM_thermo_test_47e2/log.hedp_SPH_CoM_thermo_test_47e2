fix ele_dyn_wid electron dynamic_widths 1 1 1 1.3 ${cutoff} ${type_avoid} confine_fixed
fix ele_dyn_wid electron dynamic_widths 1 1 1 1.3 12 ${type_avoid} confine_fixed
