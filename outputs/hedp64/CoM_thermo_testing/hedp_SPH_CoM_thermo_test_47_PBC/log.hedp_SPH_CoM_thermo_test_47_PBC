fix ele_dyn_wid electron dynamic_widths_com 1.3 1 1 1.3 8 16 ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com 1.3 1 1 1.3 8 16 10 ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com 1.3 1 1 1.3 8 16 10 1 ${elements_per_electron} ${tag_ele_start} ${pair_name}
