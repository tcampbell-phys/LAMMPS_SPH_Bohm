fix ele_dyn_wid electron dynamic_widths_com 1.3 1 1 1.3 8 16 10 1 128 1 bohm_SPH_dynamic_Mocz

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8 ${gamma_factor} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8 1822.888483 confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8 1822.888483 confine 0.00019453125 ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8 1822.888483 confine 0.00019453125 8 ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8 1822.888483 confine 0.00019453125 8 16 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8 1822.888483 confine 0.00019453125 8 16 128

# Set up each pair with the correct styles:

pair_coeff * * confine
pair_coeff * * ${pair_name}
pair_coeff * * bohm_SPH_dynamic_Mocz

fix all_nve all nve
velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 7 rot yes dist gaussian

# custom logfile output

thermo_style custom step temp pe ke etotal press

# modify logfile output

min_style cg
