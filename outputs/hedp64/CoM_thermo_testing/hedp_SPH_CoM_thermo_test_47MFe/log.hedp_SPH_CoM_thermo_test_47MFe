  create_atoms CPU = 0.000474794 secs
group electron type 1
192 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 5.7143740625e-06
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.0104166666666667
