pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 10 1 confine_fixed 0.02469 10 5 ${half_box_len} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 10 1 confine_fixed 0.02469 10 5 5 ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 10 1 confine_fixed 0.02469 10 5 5 5

# Set up each pair with the correct styles:

pair_coeff * * confine_fixed
pair_coeff * * ${pair_name}
pair_coeff * * bohm_SPH_dynamic_Mocz

fix all_nvt all nvt temp ${temptouse} 0.001 ${e_temp_damping}
fix all_nvt all nvt temp 100 0.001 ${e_temp_damping}
fix all_nvt all nvt temp 100 0.001 0.125

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 100 7 rot yes dist gaussian

# custom logfile output

thermo_style custom step temp pe ke etotal press

