  2 by 2 by 2 MPI processor grid

create_atoms 1 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 1 random 256 ${e_up_a_seed} NULL
create_atoms 1 random 256 2 NULL
Created 256 atoms
  create_atoms CPU = 0.00054352 secs
group electron type 1
256 atoms in group electron
mass 1 ${element_scaled_mass}
mass 1 2.1428902734375e-06
set type 1 charge ${element_scaled_charge}
set type 1 charge -0.00390625
