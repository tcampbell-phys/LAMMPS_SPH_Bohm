pair_style ${pair_name} ${cutoff} ${gamma_factor}
pair_style bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor}
pair_style bohm_SPH_dynamic_Mocz 2.23901141887935 ${gamma_factor}
pair_style bohm_SPH_dynamic_Mocz 2.23901141887935 1822.888483

