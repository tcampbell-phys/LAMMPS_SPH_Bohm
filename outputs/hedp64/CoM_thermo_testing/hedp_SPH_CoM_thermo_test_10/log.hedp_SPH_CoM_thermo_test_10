pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8 1 confine 0.02469 8 16.4971771859341 8

# Set up each pair with the correct styles:

pair_coeff * * ${pair_name}
pair_coeff * * bohm_SPH_dynamic_Mocz
pair_coeff * * confine

fix all_nve all nve

# fix all_nvt_CoM all nvt_CoM temp_CoM ${temptouse} ${temptouse} ${e_temp_damping} ${elements_per_electron} ${num_electrons} ${tag_ele_start} ${electron_amu}

# fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 124980.703017 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 124980.703017 7 rot yes dist gaussian

