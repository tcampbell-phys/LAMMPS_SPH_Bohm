fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.6 6 ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.6 6 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.6 6 1 bohm_SPH_dynamic_Mocz

