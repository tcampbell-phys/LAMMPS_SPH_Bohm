  2 by 2 by 2 MPI processor grid

create_atoms 1 random ${num_ions} ${ion_seed} NULL
create_atoms 1 random 1 ${ion_seed} NULL
create_atoms 1 random 1 110 NULL
Created 1 atoms
  create_atoms CPU = 8.65e-05 secs
group ion type 1
1 atoms in group ion
mass 1 ${ion_amu}
mass 1 1.008
set type 1 charge ${ion_charge}
set type 1 charge 1
  1 settings made for charge

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 2 random 256 ${e_up_a_seed} NULL
create_atoms 2 random 256 120 NULL
Created 256 atoms
  create_atoms CPU = 0.000652313 secs
group electron type 2
256 atoms in group electron
mass 2 ${element_scaled_mass}
mass 2 2.1428902734375e-06
set type 2 charge ${element_scaled_charge}
set type 2 charge -0.00390625
  256 settings made for charge

variable tag_ele_start equal ${num_ions}+1
variable tag_ele_start equal 1+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.7
variable N_iter equal 16
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.7*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.7*8/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.7*8/(256^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.7 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.7 16 ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.7 16 1 ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.7 16 1 2 ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.7 16 1 2 12 ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.7 16 1 2 12 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.7 16 1 2 12 1 bohm_SPH_dynamic_Mocz_rob

