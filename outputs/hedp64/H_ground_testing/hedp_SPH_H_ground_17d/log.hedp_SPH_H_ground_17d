pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 12 1822.888483 coul/cut/SPH_nopseudo_sub 12 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 12 1822.888483 coul/cut/SPH_nopseudo_sub 12 1.0 1 256 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 12 1822.888483 coul/cut/SPH_nopseudo_sub 12 1.0 1 256 2 ${assign_ion} ${targ_coord}
