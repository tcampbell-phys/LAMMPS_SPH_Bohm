pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_ftwo 10 1822.888483 coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_ftwo 10 1822.888483 coul/cut/SPH_nopseudo_sub 10 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_ftwo 10 1822.888483 coul/cut/SPH_nopseudo_sub 10 1.0 1 64 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_ftwo 10 1822.888483 coul/cut/SPH_nopseudo_sub 10 1.0 1 64 2 ${assign_ion} ${targ_coord}
