fix ele_dyn_wid electron dynamic_widths_com 1.3 1 1 1.5 10 2 1 1 64 2 ${pair_name}
fix ele_dyn_wid electron dynamic_widths_com 1.3 1 1 1.5 10 2 1 1 64 2 bohm_SPH_dynamic_Mocz_rob_ftwo

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_ftwo ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${targ_coord}
