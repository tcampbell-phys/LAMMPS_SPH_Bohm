pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 2.5 1822.888483 coul/cut/SPH_nopseudo_sub_fix 2.5 1.0 1 60 2 1 ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 2.5 1822.888483 coul/cut/SPH_nopseudo_sub_fix 2.5 1.0 1 60 2 1 0.75

# Set up each pair with the correct styles:

pair_coeff * * coul/cut/SPH_nopseudo_sub_fix

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz_rob

# increase number of allowed neighbours
