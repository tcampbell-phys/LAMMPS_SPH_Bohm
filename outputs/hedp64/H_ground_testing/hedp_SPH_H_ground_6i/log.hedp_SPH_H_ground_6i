  create_atoms CPU = 1.3535e-05 secs
group ion type 1
1 atoms in group ion
mass 1 ${ion_amu}
mass 1 1.008
set type 1 charge ${ion_charge}
set type 1 charge 1
  1 settings made for charge

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 2 random 60 ${e_up_a_seed} NULL
create_atoms 2 random 60 2 NULL
Created 60 atoms
  create_atoms CPU = 0.000321509 secs
group electron type 2
60 atoms in group electron
mass 2 ${element_scaled_mass}
mass 2 9.1429985e-06
set type 2 charge ${element_scaled_charge}
set type 2 charge -1
  60 settings made for charge

variable tag_ele_start equal ${num_ions}+1
variable tag_ele_start equal 1+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*7.5/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.3*7.5/(60^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths to ensure calculation of electron Centres of Mass

fix ele_fix_wid electron fixed_widths ${global_width} ${cutoff} ${type_avoid} ${pair_name}
