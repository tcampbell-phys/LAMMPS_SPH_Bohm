variable e_up_a_vel_seed equal 90
variable e_up_b_vel_seed equal 100

variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*0

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 10
variable rdf_output_time_step equal 40
variable rdf_measurement_time_gap equal 1

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 8 0.0 ${box_len} 0.0 ${box_len}
