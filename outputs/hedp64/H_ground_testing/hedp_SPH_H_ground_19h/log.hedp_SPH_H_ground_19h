
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 0.000	         # temperature in Ev
variable ion_density equal 0.044545217  		# Density in # per bohr^3
variable num_ions equal 1	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable global_width equal 0.4                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 256

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/256
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/256

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 1*${ion_charge}
variable num_electrons equal 1*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 1*${elements_per_electron}
variable num_electron_elements equal 1*256
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 1/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 0.5/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*0
# variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal 11.0
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 11/2.0

variable init_gaussian_width equal 0.8845
variable init_seed equal 71234792

variable confine_strength equal 0.0        # set strength of qudratic confinement potential for SPH elements belonging to the same electron

### simulation parameters:

variable cutoff equal 10.0                                     # cutoff for pairwise calculations

variable assign_ion equal 1    # if set to 1, all ions moved to targ coord on first timestep
variable targ_coord equal ${half_box_len}
variable targ_coord equal 5.5

units electron                                                      # use electron units (Hartree)
newton on
boundary s s s
atom_style SPH_CoM

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_rob

variable ion_seed equal 110
variable e_up_a_seed equal 120
variable e_up_b_seed equal 130
variable e_down_a_seed equal 140
variable e_down_b_seed equal 150

# thermostat parameters

variable ion_vel_seed equal 160
variable e_down_a_vel_seed equal 170
variable e_down_b_vel_seed equal 180
variable e_up_a_vel_seed equal 190
variable e_up_b_vel_seed equal 200

variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*0

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 10
variable rdf_output_time_step equal 40
variable rdf_measurement_time_gap equal 1

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 11 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 11 0.0 11 0.0 ${box_len}
region bounding_region block 0.0 11 0.0 11 0.0 11

create_box 2 bounding_region
Created orthogonal box = (0 0 0) to (11 11 11)
  2 by 2 by 2 MPI processor grid

create_atoms 1 random ${num_ions} ${ion_seed} NULL
create_atoms 1 random 1 ${ion_seed} NULL
create_atoms 1 random 1 110 NULL
Created 1 atoms
  create_atoms CPU = 9.2386e-05 secs
group ion type 1
1 atoms in group ion
mass 1 ${ion_amu}
mass 1 1.008
set type 1 charge ${ion_charge}
set type 1 charge 1
  1 settings made for charge

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 2 random 256 ${e_up_a_seed} NULL
create_atoms 2 random 256 120 NULL
Created 256 atoms
  create_atoms CPU = 0.000611675 secs
group electron type 2
256 atoms in group electron
mass 2 ${element_scaled_mass}
mass 2 2.1428902734375e-06
set type 2 charge ${element_scaled_charge}
set type 2 charge -0.00390625
  256 settings made for charge

variable tag_ele_start equal ${num_ions}+1
variable tag_ele_start equal 1+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 2.0
variable N_iter equal 32
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*2*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*2*11/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*2*11/(256^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix ele_fix_wid electron fixed_widths ${global_width} ${cutoff} ${type_avoid} ${pair_name}
fix ele_fix_wid electron fixed_widths 0.4 ${cutoff} ${type_avoid} ${pair_name}
fix ele_fix_wid electron fixed_widths 0.4 10 ${type_avoid} ${pair_name}
fix ele_fix_wid electron fixed_widths 0.4 10 1 ${pair_name}
fix ele_fix_wid electron fixed_widths 0.4 10 1 bohm_SPH_dynamic_Mocz_rob

fix ele_spher_init electron spherical_init ${init_gaussian_width} ${half_box_len} ${num_electron_elements} ${init_seed}
fix ele_spher_init electron spherical_init 0.8845 ${half_box_len} ${num_electron_elements} ${init_seed}
fix ele_spher_init electron spherical_init 0.8845 5.5 ${num_electron_elements} ${init_seed}
fix ele_spher_init electron spherical_init 0.8845 5.5 256 ${init_seed}
fix ele_spher_init electron spherical_init 0.8845 5.5 256 71234792

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub_fix ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub_fix ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 10 ${gamma_factor} coul/cut/SPH_nopseudo_sub_fix ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 10 1822.888483 coul/cut/SPH_nopseudo_sub_fix ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 10 1822.888483 coul/cut/SPH_nopseudo_sub_fix 10 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 10 1822.888483 coul/cut/SPH_nopseudo_sub_fix 10 1.0 1 256 ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 10 1822.888483 coul/cut/SPH_nopseudo_sub_fix 10 1.0 1 256 2 ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 10 1822.888483 coul/cut/SPH_nopseudo_sub_fix 10 1.0 1 256 2 1 ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 10 1822.888483 coul/cut/SPH_nopseudo_sub_fix 10 1.0 1 256 2 1 5.5

# Set up each pair with the correct styles:

pair_coeff * * coul/cut/SPH_nopseudo_sub_fix

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz_rob

# increase number of allowed neighbours
neigh_modify one 10000

velocity all create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 160 rot yes dist gaussian

#velocity ion create ${temptouse} ${ion_vel_seed} #rot yes dist gaussian

#velocity electron create ${vel_t} ${e_down_a_vel_seed} #rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

compute electron_temp electron temp

# Compute pair correlation functions:
compute ion_electron_rdf all rdf ${rdf_num_bins} 1 2
compute ion_electron_rdf all rdf 150 1 2

compute electron_electron_rdf all rdf ${rdf_num_bins} 2 2
compute electron_electron_rdf all rdf 150 2 2

fix write_ion_electron_rdf all ave/time ${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} c_ion_electron_rdf[*] file /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/ion_electron.rdf mode vector
