pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix ${cutoff} 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 128 ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 128 2 ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 128 2 1 ${half_box_len}
