variable tag_ele_start equal ${num_ions}+1
variable tag_ele_start equal 1+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.5
variable N_iter equal 16
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.5*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.5*8/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.5*8/(128^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.5 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
