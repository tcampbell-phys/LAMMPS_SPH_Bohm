pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub 8 1.0 1 ${elements_per_electron} ${tag_ele_start} ${assign_ion} ${targ_coord}
