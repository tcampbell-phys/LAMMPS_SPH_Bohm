variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 1/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 0.5/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*0.005
# variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal 1.5
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 1.5/2.0

variable confine_strength equal 0.0        # set strength of qudratic confinement potential for SPH elements belonging to the same electron

### simulation parameters:

variable time_step_length equal 0.125e-3
variable equi_time_steps equal 2e4
variable buff_time_steps equal 1e2
variable CoM_check_time_steps equal 1e2
variable dump_freq equal 1
variable cutoff equal 10.0                                     # cutoff for pairwise calculations

variable assign_ion equal 1    # if set to 1, all ions moved to targ coord on first timestep
variable targ_coord equal ${half_box_len}
variable targ_coord equal 0.75

units electron                                                      # use electron units (Hartree)
newton on
boundary s s s
atom_style SPH_CoM

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_rob

variable ion_seed equal 1
variable e_up_a_seed equal 2
variable e_up_b_seed equal 3
variable e_down_a_seed equal 4
variable e_down_b_seed equal 5

# thermostat parameters

variable ion_vel_seed equal 6
variable e_down_a_vel_seed equal 7
variable e_down_b_vel_seed equal 8
variable e_up_a_vel_seed equal 9
variable e_up_b_vel_seed equal 10

variable i_temp_damping equal ${time_step_length}*100
variable i_temp_damping equal 0.000125*100
variable e_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal 0.000125*100

variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*58.0226105

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 10
variable rdf_output_time_step equal 40
variable rdf_measurement_time_gap equal 1

### Setup simulation

