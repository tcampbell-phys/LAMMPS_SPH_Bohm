pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.6393286905013 sub_minoo 8.8 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.6393286905013 sub_minoo 8.8 124980.703017 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.6393286905013 sub_minoo 8.8 124980.703017 0.00054857991 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.6393286905013 sub_minoo 8.8 124980.703017 0.00054857991 8

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

