  create_atoms CPU = 7.98702e-05 secs
group electron type 2
2000 atoms in group electron
mass 2 ${element_scaled_mass}
mass 2 0.0001371449775
set type 2 charge ${element_scaled_charge}
set type 2 charge -0.25
