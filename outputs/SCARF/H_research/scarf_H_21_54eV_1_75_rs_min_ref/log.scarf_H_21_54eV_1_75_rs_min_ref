variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*21.54
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (512/${ion_density})^(1/3)
variable box_len equal (512/0.044545217)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 22.5678209408086/2.0

### simulation parameters:

variable time_step_length equal 0.25e-3
variable equi_time_steps equal 1e3
variable buff_time_steps equal 1e3
variable ele_data_time_steps equal 1e3
