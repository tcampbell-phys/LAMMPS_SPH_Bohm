velocity ion create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity ion create 124980.703017 ${ion_vel_seed} rot yes dist gaussian
velocity ion create 124980.703017 36388 rot yes dist gaussian

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 124980.703017 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 124980.703017 29411 rot yes dist gaussian

