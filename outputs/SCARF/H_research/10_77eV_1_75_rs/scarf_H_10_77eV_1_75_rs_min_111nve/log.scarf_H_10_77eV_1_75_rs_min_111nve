pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 7.98 ${gamma_factor} confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 7.98 1 confine ${confine_strength} ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 7.98 1 confine 2 ${cutoff} ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 7.98 1 confine 2 7.98 ${box_len} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 7.98 1 confine 2 7.98 16.4971771859341 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 7.98 1 confine 2 7.98 16.4971771859341 16

# Set up each pair with the correct styles:

pair_coeff * * ${pair_name}
pair_coeff * * bohm_SPH_dynamic_Mocz
pair_coeff * * confine

# increase number of allowed neighbours
neigh_modify one 10000

### Thermostatting

fix all_nve all nve

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 124980.703017 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 124980.703017 7 rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

