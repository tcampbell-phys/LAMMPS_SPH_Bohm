# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.15
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.15*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.15*35.5420908169789/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.15*35.5420908169789/(16000^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.63932869050128 sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.63932869050128 sub_minoo 8.8 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.63932869050128 sub_minoo 8.8 124980.703017 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.63932869050128 sub_minoo 8.8 124980.703017 0.00054857991 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 8.8 1 coul/long/SPH_nopseudo_ph 8.8 1.0 1 7.63932869050128 sub_minoo 8.8 124980.703017 0.00054857991 8

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/8.8
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
