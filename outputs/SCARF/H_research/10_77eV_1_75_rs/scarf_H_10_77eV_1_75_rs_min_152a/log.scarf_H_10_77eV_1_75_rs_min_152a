
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 10.77	         # temperature in Ev
variable ion_density equal 0.044545217  		# Density in # per bohr^3
variable num_ions equal 289	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 3.4                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 1

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/1
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/1

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 289*${ion_charge}
variable num_electrons equal 289*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 289*${elements_per_electron}
variable num_electron_elements equal 289*1
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 289/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 144.5/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*10.77
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (289/${ion_density})^(1/3)
variable box_len equal (289/0.044545217)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 18.6508625400852/2.0

variable confine_strength equal 0.2        # set strength of qudratic confinement potential for SPH elements belonging to the same electron

### simulation parameters:

variable time_step_length equal 0.25e-3
variable block_time_steps equal 2e5
variable CoM_check_time_steps equal 2000
variable CoM_freq equal 10
variable data_block_time_steps equal 5.9997e5
variable e_dump_ts_freq equal 70
variable cutoff equal 8.0                                  # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable rnseed index 10
variable number equal ceil(random(1,10000000000,${rnseed})/100000.0)
