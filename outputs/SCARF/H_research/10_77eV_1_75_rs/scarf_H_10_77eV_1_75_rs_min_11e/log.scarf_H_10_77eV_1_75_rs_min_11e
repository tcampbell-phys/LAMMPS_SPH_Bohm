region bounding_region block 0.0 32.2921325679212 0.0 32.2921325679212 0.0 ${box_len}
region bounding_region block 0.0 32.2921325679212 0.0 32.2921325679212 0.0 32.2921325679212
timestep ${time_step_length}
timestep 0.00025

create_box 2 bounding_region
