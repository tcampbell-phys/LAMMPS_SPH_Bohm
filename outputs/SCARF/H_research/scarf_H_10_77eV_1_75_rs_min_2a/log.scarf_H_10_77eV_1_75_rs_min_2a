
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 10.77	         # temperature in Ev
variable ion_density equal 0.044545217  		# Density in # per bohr^3
variable num_ions equal 2000	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.6                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 8

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/8
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/8

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 2000*${ion_charge}
variable num_electrons equal 2000*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 2000*${elements_per_electron}
variable num_electron_elements equal 2000*8
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 2000/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 1000/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*10.77
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (2000/${ion_density})^(1/3)
variable box_len equal (2000/0.044545217)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 35.5420908169789/2.0

### simulation parameters:

variable time_step_length equal 0.5e-3
variable equi_time_steps equal 5e5
variable buff_time_steps equal 1e5
variable ion_data_time_steps equal 1.0e6
variable ele_data_time_steps equal 1.0e5
variable dump_ts_freq equal 1e2
variable e_dump_ts_freq equal 4
variable cutoff equal 8.8                                        # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable rnseed index 10
variable number equal ceil(random(1,10000000000,${rnseed})/100000.0)
variable number equal ceil(random(1,10000000000,15373)/100000.0)

variable ion_seed equal ${number}
variable ion_seed equal 72106
variable e_up_a_seed equal ${number}
variable e_up_a_seed equal 83553
variable e_up_b_seed equal ${number}
variable e_up_b_seed equal 48196
variable e_down_a_seed equal ${number}
variable e_down_a_seed equal 79658
variable e_down_b_seed equal ${number}
variable e_down_b_seed equal 37310

# thermostat parameters

variable ion_vel_seed equal ${number}
variable ion_vel_seed equal 58855
variable e_down_a_vel_seed equal ${number}
variable e_down_a_vel_seed equal 83325
variable e_down_b_vel_seed equal ${number}
variable e_down_b_vel_seed equal 74307
variable e_up_a_vel_seed equal ${number}
variable e_up_a_vel_seed equal 35177
variable e_up_b_vel_seed equal ${number}
variable e_up_b_vel_seed equal 47532

variable i_temp_damping equal ${time_step_length}*100
variable i_temp_damping equal 0.0005*100
variable e_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal 0.0005*100

### NOTE - initialising particles from rest
variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*124980.703017

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 4000
variable rdf_measurement_time_gap equal 10

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 35.5420908169789 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 35.5420908169789 0.0 35.5420908169789 0.0 ${box_len}
region bounding_region block 0.0 35.5420908169789 0.0 35.5420908169789 0.0 35.5420908169789
timestep ${time_step_length}
timestep 0.0005

create_box 2 bounding_region
