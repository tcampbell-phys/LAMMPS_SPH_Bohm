pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 11.6 1 coul/long/SPH_nopseudo_ph 11.6 1.0 1 11.5045904353871 sub_minoo 11.6 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 11.6 1 coul/long/SPH_nopseudo_ph 11.6 1.0 1 11.5045904353871 sub_minoo 11.6 182307.042191 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 11.6 1 coul/long/SPH_nopseudo_ph 11.6 1.0 1 11.5045904353871 sub_minoo 11.6 182307.042191 0.00054857991 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 11.6 1 coul/long/SPH_nopseudo_ph 11.6 1.0 1 11.5045904353871 sub_minoo 11.6 182307.042191 0.00054857991 1

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

