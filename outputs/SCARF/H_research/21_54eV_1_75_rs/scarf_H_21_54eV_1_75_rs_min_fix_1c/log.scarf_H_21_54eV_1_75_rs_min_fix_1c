
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 21.54	         # temperature in Ev
variable ion_density equal 0.044545217  		# Density in # per bohr^3
variable num_ions equal 512	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable global_width equal 1.02                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 1

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/1
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/1

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 512*${ion_charge}
variable num_electrons equal 512*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 512*${elements_per_electron}
variable num_electron_elements equal 512*1
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 512/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 256/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*21.54
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (512/${ion_density})^(1/3)
variable box_len equal (512/0.044545217)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 22.5678209408086/2.0

### simulation parameters:

variable time_step_length equal 0.25e-3
variable equi_time_steps equal 8e5
variable buff_time_steps equal 2e5
variable ele_data_time_steps equal 1.9999e6
variable e_dump_ts_freq equal 70
variable cutoff equal 6.3                                  # cutoff for pairwise calculations
variable cutoff_SPH equal 4.62
variable cutoff_Minoo equal 3.743

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_rob_ftwo

variable ion_seed equal 10
variable e_up_a_seed equal 20
variable e_up_b_seed equal 30
variable e_down_a_seed equal 40
variable e_down_b_seed equal 50

# thermostat parameters

variable ion_vel_seed equal 60
variable e_down_a_vel_seed equal 70
variable e_down_b_vel_seed equal 80
variable e_up_a_vel_seed equal 90
variable e_up_b_vel_seed equal 100

variable i_temp_damping equal ${time_step_length}*100
variable i_temp_damping equal 0.00025*100
variable e_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal 0.00025*100

variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*249961.406034

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 4000
variable rdf_measurement_time_gap equal 10

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 22.5678209408086 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 22.5678209408086 0.0 22.5678209408086 0.0 ${box_len}
region bounding_region block 0.0 22.5678209408086 0.0 22.5678209408086 0.0 22.5678209408086
timestep ${time_step_length}
timestep 0.00025

create_box 2 bounding_region
