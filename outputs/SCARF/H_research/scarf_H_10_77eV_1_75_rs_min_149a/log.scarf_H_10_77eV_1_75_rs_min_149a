variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*10.77
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (289/${ion_density})^(1/3)
variable box_len equal (289/0.044545217)^(1/3)
