pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 12.67 1 coul/long/SPH_nopseudo_ph_sub 12.67 1.0 1 12.6539252865731 2 1501 sub_minoo 12.67 124980.703017 0.00054857991 2 1501

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph_sub

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

