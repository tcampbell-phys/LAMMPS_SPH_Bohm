  create_atoms CPU = 0.00142598 secs
group ion type 1
2000 atoms in group ion
mass 1 ${ion_amu}
mass 1 1.008
set type 1 charge ${ion_charge}
set type 1 charge 1
  2000 settings made for charge

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 2 random 2000 ${e_up_a_seed} NULL
create_atoms 2 random 2000 78011 NULL
