fix ele_nvt electron nvt temp ${temptouse} ${temptouse} ${e_temp_damping}
fix ele_nvt electron nvt temp 124980.703017 ${temptouse} ${e_temp_damping}
fix ele_nvt electron nvt temp 124980.703017 124980.703017 ${e_temp_damping}
fix ele_nvt electron nvt temp 124980.703017 124980.703017 0.05

