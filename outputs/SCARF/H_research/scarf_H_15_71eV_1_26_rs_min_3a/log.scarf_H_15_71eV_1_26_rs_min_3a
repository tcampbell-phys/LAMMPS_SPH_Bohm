pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 5.8 1 coul/long/SPH_nopseudo_ph 5.8 1.0 1 5.75229521769355 sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 5.8 1 coul/long/SPH_nopseudo_ph 5.8 1.0 1 5.75229521769355 sub_minoo 5.8 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 5.8 1 coul/long/SPH_nopseudo_ph 5.8 1.0 1 5.75229521769355 sub_minoo 5.8 182307.042191 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 5.8 1 coul/long/SPH_nopseudo_ph 5.8 1.0 1 5.75229521769355 sub_minoo 5.8 182307.042191 0.00054857991 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 5.8 1 coul/long/SPH_nopseudo_ph 5.8 1.0 1 5.75229521769355 sub_minoo 5.8 182307.042191 0.00054857991 8

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/5.8
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
