variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*10.77
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (250/${ion_density})^(1/3)
variable box_len equal (250/0.044545217)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 17.7710454084895/2.0

variable confine_strength equal 0.0        # set strength of qudratic confinement potential for SPH elements belonging to the same electron

### simulation parameters:

variable time_step_length equal 0.25e-3
variable block_time_steps equal 2e5
variable CoM_check_time_steps equal 2000
variable CoM_freq equal 10
variable cutoff equal 0.999999*${half_box_len}                                  # cutoff for pairwise calculations
variable cutoff equal 0.999999*8.88552270424475                                  

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

