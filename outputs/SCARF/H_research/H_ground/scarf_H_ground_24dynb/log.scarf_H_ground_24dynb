
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 0.000	         # temperature in eV
variable num_ions equal 1	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 0.9                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 515 # must match number of elements generated on lattice

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
