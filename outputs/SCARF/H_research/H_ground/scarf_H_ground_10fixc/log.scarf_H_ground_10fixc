pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 512 ${tag_ele_start} ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 512 2 ${assign_ion} ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 512 2 0 ${half_box_len}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 8 1822.888483 coul/cut/SPH_nopseudo_sub_fix 8 1.0 1 512 2 0 2.5

# Set up each pair with the correct styles:

pair_coeff * * coul/cut/SPH_nopseudo_sub_fix

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz_rob

# increase number of allowed neighbours
neigh_modify one 10000

velocity all create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 78792 rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

compute electron_temp electron temp

# Compute pair correlation functions:
compute ion_electron_rdf all rdf ${rdf_num_bins} 1 2
compute ion_electron_rdf all rdf 150 1 2

compute electron_electron_rdf all rdf ${rdf_num_bins} 2 2
compute electron_electron_rdf all rdf 150 2 2

