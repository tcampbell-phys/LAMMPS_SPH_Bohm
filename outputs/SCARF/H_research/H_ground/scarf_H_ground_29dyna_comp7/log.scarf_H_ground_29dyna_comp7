
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 0.000	         # temperature in eV
variable num_ions equal 1	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 0.9                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 1237 # must match number of elements generated on lattice

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/1237
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/1237

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 1*${ion_charge}
variable num_electrons equal 1*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 1*${elements_per_electron}
variable num_electron_elements equal 1*1237
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*0

### simulation parameters:

variable radius equal 2.5
variable cutoff equal 5.0  # cutoff for pairwise calculations

variable assign_ion equal 1    # if set to 1, all ions moved to targ coord on first timestep
variable targ_coord equal 0.0

variable lattice_const equal 0.375 # tune lattice constant so that number of atoms produced equals elements_per_electron (for accurate mass and charge values)

units electron                                                      # use electron units (Hartree)
newton on
boundary s s s
atom_style SPH_CoM

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_doub_rob_ftwo

variable ion_seed equal 99919
variable e_up_a_seed equal 25132
variable e_up_b_seed equal 79840
variable e_down_a_seed equal 21611
variable e_down_b_seed equal 99020

# thermostat parameters

variable ion_vel_seed equal 12964
variable e_down_a_vel_seed equal 85890
variable e_down_b_vel_seed equal 66097
variable e_up_a_vel_seed equal 13720
variable e_up_b_vel_seed equal 31943

variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*0

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 10
variable rdf_output_time_step equal 4000
variable rdf_measurement_time_gap equal 1

### Setup simulation

region bounding_region sphere 0.0 0.0 0.0 ${radius} units box
region bounding_region sphere 0.0 0.0 0.0 2.5 units box

lattice sc ${lattice_const} origin 0.0 0.0 0.0
lattice sc 0.375 origin 0.0 0.0 0.0
