pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_pot 5 1822.888483 2469 coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_pot 5 1822.888483 2469 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_pot 5 1822.888483 2469 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 2 ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_pot 5 1822.888483 2469 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 2 1 ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_pot 5 1822.888483 2469 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 2 1 0

# Set up each pair with the correct styles:

pair_coeff * * coul/cut/SPH_nopseudo_sub

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz_rob_pot

# increase number of allowed neighbours
neigh_modify one 10000

velocity all create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 8862 rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.005 0.005 0.005 42

compute electron_temp electron temp

# Compute pair correlation functions:
compute ion_electron_rdf all rdf ${rdf_num_bins} 1 2
