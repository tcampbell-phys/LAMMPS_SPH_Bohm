variable tag_ele_start equal ${num_ions}+1
variable tag_ele_start equal 1+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 4
variable mix_fact equal 1.0
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 4 ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 4 1 ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 4 1 0.9 ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 4 1 0.9 5 ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 4 1 0.9 5 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 4 1 0.9 5 1 bohm_SPH_dynamic_Mocz_rob

# set large 'elements_per_electron' argument to coul/cut/SPH_nopseudo_sub to ensure no electron - electron self interaction

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 5 ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 5 1822.888483 coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 5 1822.888483 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 5 1822.888483 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 2 ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 5 1822.888483 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 2 1 ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob 5 1822.888483 coul/cut/SPH_nopseudo_sub 5 1.0 1 10000 2 1 0

# Set up each pair with the correct styles:

pair_coeff * * coul/cut/SPH_nopseudo_sub

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz_rob

# increase number of allowed neighbours
neigh_modify one 10000

velocity all create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 ${ion_vel_seed} rot yes dist gaussian
velocity all create 0 12964 rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.005 0.005 0.005 42

compute electron_temp electron temp

# Compute pair correlation functions:
compute ion_electron_rdf all rdf ${rdf_num_bins} 1 2
compute ion_electron_rdf all rdf 150 1 2

compute electron_electron_rdf all rdf ${rdf_num_bins} 2 2
compute electron_electron_rdf all rdf 150 2 2

