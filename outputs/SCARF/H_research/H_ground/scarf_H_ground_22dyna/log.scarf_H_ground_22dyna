
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 0.000	         # temperature in eV
variable num_ions equal 1	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 0.9                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 515

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/515
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/515

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 1*${ion_charge}
variable num_electrons equal 1*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 1*${elements_per_electron}
variable num_electron_elements equal 1*515
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*0

### simulation parameters:

variable radius equal 3.0
variable cutoff equal 6.0  # cutoff for pairwise calculations

variable assign_ion equal 1    # if set to 1, all ions moved to targ coord on first timestep
variable targ_coord equal 0.0

variable lattice_const equal 0.6 # tune lattice constant so that number of atoms produced equals elements_per_electron (for accurate mass and charge values)

units electron                                                      # use electron units (Hartree)
newton on
boundary s s s
atom_style SPH_CoM

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_rob_pot

variable rnseed index 10
variable number equal ceil(random(1,10000000000,${rnseed})/100000.0)
variable number equal ceil(random(1,10000000000,25245)/100000.0)

variable ion_seed equal ${number}
variable ion_seed equal 34327
variable e_up_a_seed equal ${number}
variable e_up_a_seed equal 74674
variable e_up_b_seed equal ${number}
variable e_up_b_seed equal 41425
variable e_down_a_seed equal ${number}
variable e_down_a_seed equal 29085
variable e_down_b_seed equal ${number}
variable e_down_b_seed equal 32266

# thermostat parameters

variable ion_vel_seed equal ${number}
variable ion_vel_seed equal 77891
variable e_down_a_vel_seed equal ${number}
variable e_down_a_vel_seed equal 96648
variable e_down_b_vel_seed equal ${number}
variable e_down_b_vel_seed equal 4000
variable e_up_a_vel_seed equal ${number}
variable e_up_a_vel_seed equal 99002
variable e_up_b_vel_seed equal ${number}
variable e_up_b_vel_seed equal 13324

variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*0

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 10
variable rdf_output_time_step equal 4000
variable rdf_measurement_time_gap equal 1

### Setup simulation

region bounding_region sphere 0.0 0.0 0.0 ${radius} units box
region bounding_region sphere 0.0 0.0 0.0 3 units box

lattice sc ${lattice_const} origin 0.0 0.0 0.0
lattice sc 0.6 origin 0.0 0.0 0.0
Lattice spacing in x,y,z = 0.6 0.6 0.6

create_box 2 bounding_region
Created orthogonal box = (-3 -3 -3) to (3 3 3)
  2 by 2 by 4 MPI processor grid

create_atoms 1 random ${num_ions} ${ion_seed} NULL
create_atoms 1 random 1 ${ion_seed} NULL
create_atoms 1 random 1 34327 NULL
Created 1 atoms
  create_atoms CPU = 0.000185013 secs
group ion type 1
1 atoms in group ion
mass 1 ${ion_amu}
mass 1 1.008
set type 1 charge ${ion_charge}
set type 1 charge 1
  1 settings made for charge

create_atoms 2 region bounding_region
Created 515 atoms
  create_atoms CPU = 0.000415087 secs
group electron type 2
515 atoms in group electron
mass 2 ${element_scaled_mass}
mass 2 1.06520370873786e-06
set type 2 charge ${element_scaled_charge}
set type 2 charge -0.00194174757281553
  515 settings made for charge

variable tag_ele_start equal ${num_ions}+1
variable tag_ele_start equal 1+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 8
variable mix_fact equal 1.0
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 1 ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
