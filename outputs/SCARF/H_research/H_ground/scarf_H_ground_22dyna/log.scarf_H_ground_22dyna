fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.9 6 ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.9 6 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.9 6 1 bohm_SPH_dynamic_Mocz_rob_pot

# set large 'elements_per_electron' argument to coul/cut/SPH_nopseudo_sub to ensure no electron - electron self interaction

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_pot ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
