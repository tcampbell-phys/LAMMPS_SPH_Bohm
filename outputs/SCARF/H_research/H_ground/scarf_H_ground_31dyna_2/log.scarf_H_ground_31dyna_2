variable lattice_const equal 0.3 # tune lattice constant so that number of atoms produced equals elements_per_electron (for accurate mass and charge values)

units electron                                                      # use electron units (Hartree)
newton on
boundary s s s
atom_style SPH_CoM

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_rob_pot

variable rnseed index 10
