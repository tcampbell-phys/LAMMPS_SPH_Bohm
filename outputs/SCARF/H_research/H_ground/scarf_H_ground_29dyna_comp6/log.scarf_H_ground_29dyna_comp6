fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.9 ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.9 5 ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.3 8 1 0.9 5 1 ${pair_name}
