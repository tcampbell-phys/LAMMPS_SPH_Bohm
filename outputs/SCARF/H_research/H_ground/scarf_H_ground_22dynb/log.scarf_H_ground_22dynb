pair_style hybrid/overlay bohm_SPH_dynamic_Mocz_rob_pot 6 1822.888483 coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}
