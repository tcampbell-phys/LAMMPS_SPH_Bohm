pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9.2 1 coul/long/SPH_nopseudo_ph 9.2 1.0 1 9.13119947979839 sub_minoo 9.2 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9.2 1 coul/long/SPH_nopseudo_ph 9.2 1.0 1 9.13119947979839 sub_minoo 9.2 182307.042191 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9.2 1 coul/long/SPH_nopseudo_ph 9.2 1.0 1 9.13119947979839 sub_minoo 9.2 182307.042191 0.00054857991 ${elements_per_electron}
