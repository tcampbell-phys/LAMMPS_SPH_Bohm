pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 4.6 1 coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
