fix ele_dyn_wid electron dynamic_widths 1.2 1 1 1.55 7.3 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.2 1 1 1.55 7.3 1 bohm_SPH_dynamic_Mocz

fix ele_nvt electron nvt temp ${temptouse} ${temptouse} ${e_temp_damping}
fix ele_nvt electron nvt temp 182307.042191 ${temptouse} ${e_temp_damping}
fix ele_nvt electron nvt temp 182307.042191 182307.042191 ${e_temp_damping}
fix ele_nvt electron nvt temp 182307.042191 182307.042191 0.0125

