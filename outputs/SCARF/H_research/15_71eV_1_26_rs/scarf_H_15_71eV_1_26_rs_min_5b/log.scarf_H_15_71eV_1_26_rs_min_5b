pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 3.8 1 coul/long/SPH_nopseudo_ph 3.8 1.0 1 3.62371891499086 sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 3.8 1 coul/long/SPH_nopseudo_ph 3.8 1.0 1 3.62371891499086 sub_minoo 3.8 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 3.8 1 coul/long/SPH_nopseudo_ph 3.8 1.0 1 3.62371891499086 sub_minoo 3.8 182307.042191 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 3.8 1 coul/long/SPH_nopseudo_ph 3.8 1.0 1 3.62371891499086 sub_minoo 3.8 182307.042191 0.00054857991 ${elements_per_electron}
