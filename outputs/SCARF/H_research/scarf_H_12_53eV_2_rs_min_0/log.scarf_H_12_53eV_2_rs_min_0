
### SYSTEM PARAMETERS:

### physical parameters:

variable temp equal 12.528	         # temperature in Ev
variable ion_density equal 0.0298415  		# Density in # per bohr^3
variable num_ions equal 100	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.0                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 27

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/27
variable element_scaled_charge equal -1/${elements_per_electron}
variable element_scaled_charge equal -1/27

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 100*${ion_charge}
variable num_electrons equal 100*1
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable num_electron_elements equal 100*${elements_per_electron}
variable num_electron_elements equal 100*27
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 100/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 50/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*12.528
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (100/${ion_density})^(1/3)
variable box_len equal (100/0.0298415)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 14.9644163708318/2.0

### simulation parameters:

variable time_step_length equal 0.25e-3
variable equi_time_steps equal 8e5
variable buff_time_steps equal 8e4
variable ion_data_time_steps equal 4e6
variable ele_data_time_steps equal 4.0e5
variable dump_ts_freq equal 4e3
variable e_dump_ts_freq equal 40
variable cutoff equal 9.0                                        # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable rnseed index 10
variable number equal ceil(random(1,10000000000,${rnseed})/100000.0)
variable number equal ceil(random(1,10000000000,22533)/100000.0)

variable ion_seed equal ${number}
variable ion_seed equal 44340
variable e_up_a_seed equal ${number}
variable e_up_a_seed equal 3820
variable e_up_b_seed equal ${number}
variable e_up_b_seed equal 32761
variable e_down_a_seed equal ${number}
variable e_down_a_seed equal 75578
variable e_down_b_seed equal ${number}
variable e_down_b_seed equal 36684

# thermostat parameters

variable ion_vel_seed equal ${number}
variable ion_vel_seed equal 56464
variable e_down_a_vel_seed equal ${number}
variable e_down_a_vel_seed equal 71675
variable e_down_b_vel_seed equal ${number}
variable e_down_b_vel_seed equal 20887
variable e_up_a_vel_seed equal ${number}
variable e_up_a_vel_seed equal 19006
variable e_up_b_vel_seed equal ${number}
variable e_up_b_vel_seed equal 21968

variable i_temp_damping equal ${time_step_length}*100
variable i_temp_damping equal 0.00025*100
variable e_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal 0.00025*100

### NOTE - initialising particles from rest
variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*145381.4528688

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 8000
variable rdf_measurement_time_gap equal 10

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 14.9644163708318 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 14.9644163708318 0.0 14.9644163708318 0.0 ${box_len}
region bounding_region block 0.0 14.9644163708318 0.0 14.9644163708318 0.0 14.9644163708318
timestep ${time_step_length}
timestep 0.00025

create_box 2 bounding_region
Created orthogonal box = (0 0 0) to (14.9644 14.9644 14.9644)
  4 by 4 by 8 MPI processor grid

create_atoms 1 random ${num_ions} ${ion_seed} NULL
create_atoms 1 random 100 ${ion_seed} NULL
create_atoms 1 random 100 44340 NULL
Created 100 atoms
  create_atoms CPU = 0.0431759 secs
group ion type 1
100 atoms in group ion
mass 1 ${ion_amu}
mass 1 1.008
set type 1 charge ${ion_charge}
set type 1 charge 1
  100 settings made for charge

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
create_atoms 2 random 2700 ${e_up_a_seed} NULL
create_atoms 2 random 2700 3820 NULL
Created 2700 atoms
  create_atoms CPU = 0.000357151 secs
group electron type 2
2700 atoms in group electron
mass 2 ${element_scaled_mass}
mass 2 2.03177744444444e-05
set type 2 charge ${element_scaled_charge}
set type 2 charge -0.037037037037037
  2700 settings made for charge

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.15
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.15*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.15*14.9644163708318/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.15*14.9644163708318/(2700^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 1 coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 1 coul/long/SPH_nopseudo_ph 9 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 1 coul/long/SPH_nopseudo_ph 9 1.0 1 5.82046140589528 sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 1 coul/long/SPH_nopseudo_ph 9 1.0 1 5.82046140589528 sub_minoo 9 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 1 coul/long/SPH_nopseudo_ph 9 1.0 1 5.82046140589528 sub_minoo 9 145381.4528688 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 1 coul/long/SPH_nopseudo_ph 9 1.0 1 5.82046140589528 sub_minoo 9 145381.4528688 0.00054857991 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 9 1 coul/long/SPH_nopseudo_ph 9 1.0 1 5.82046140589528 sub_minoo 9 145381.4528688 0.00054857991 27

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/9
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 0.333333333333333

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.15 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
