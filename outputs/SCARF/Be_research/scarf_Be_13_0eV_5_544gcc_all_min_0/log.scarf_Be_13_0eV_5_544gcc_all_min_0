fix ele_dyn_wid electron dynamic_widths 1.15 1 1 1.90634368493586 13 1 ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.15 1 1 1.90634368493586 13 1 bohm_SPH_dynamic_Mocz

fix fermi_thermostat electron fermi_nvt_no_cons ${temptouse} ${alpha_mass} ${electron_amu} ${exp_cutoff} ${mu}
fix fermi_thermostat electron fermi_nvt_no_cons 150858.7873 ${alpha_mass} ${electron_amu} ${exp_cutoff} ${mu}
fix fermi_thermostat electron fermi_nvt_no_cons 150858.7873 200 ${electron_amu} ${exp_cutoff} ${mu}
fix fermi_thermostat electron fermi_nvt_no_cons 150858.7873 200 0.00054857991 ${exp_cutoff} ${mu}
fix fermi_thermostat electron fermi_nvt_no_cons 150858.7873 200 0.00054857991 20 ${mu}
fix fermi_thermostat electron fermi_nvt_no_cons 150858.7873 200 0.00054857991 20 1.62225

### Thermostatting

fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}
fix ion_nvt ion nvt temp 150858.7873 ${temptouse} ${i_temp_damping}
fix ion_nvt ion nvt temp 150858.7873 150858.7873 ${i_temp_damping}
fix ion_nvt ion nvt temp 150858.7873 150858.7873 0.02

velocity ion create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity ion create 150858.7873 ${ion_vel_seed} rot yes dist gaussian
velocity ion create 150858.7873 7389 rot yes dist gaussian

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 150858.7873 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 150858.7873 83671 rot yes dist gaussian

