create_atoms 2 random ${num_electrons} ${e_up_a_seed} NULL
create_atoms 2 random 3000 ${e_up_a_seed} NULL
create_atoms 2 random 3000 707 NULL
Created 3000 atoms
  create_atoms CPU = 0.000290871 secs
group electron type 2
3000 atoms in group electron
mass 2 ${electron_amu}
mass 2 0.00054857991
set type 2 charge -1.0
  3000 settings made for charge

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.15
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electrons}^(1/3))
variable tfwhm equal 4.70964*1.15*${box_len}/(${num_electrons}^(1/3))
variable tfwhm equal 4.70964*1.15*23.9080292213651/(${num_electrons}^(1/3))
variable tfwhm equal 4.70964*1.15*23.9080292213651/(3000^(1/3))
variable sigma_start equal ${dens_wid_const}*${box_len}/(${num_electrons}^(1/3))                                        # Start global packet width of electrons in bohr
variable sigma_start equal 1.15*${box_len}/(${num_electrons}^(1/3))                                        
variable sigma_start equal 1.15*23.9080292213651/(${num_electrons}^(1/3))                                        
variable sigma_start equal 1.15*23.9080292213651/(3000^(1/3))                                        
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 minoo ${cutoff} ${temptouse} ${electron_amu}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 minoo ${cutoff} ${temptouse} ${electron_amu}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 13 ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 minoo ${cutoff} ${temptouse} ${electron_amu}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 13 1 coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 minoo ${cutoff} ${temptouse} ${electron_amu}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 13 1 coul/long/SPH_nopseudo_ph 13 1.0 1 minoo ${cutoff} ${temptouse} ${electron_amu}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 13 1 coul/long/SPH_nopseudo_ph 13 1.0 1 minoo 13 ${temptouse} ${electron_amu}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 13 1 coul/long/SPH_nopseudo_ph 13 1.0 1 minoo 13 150858.7873 ${electron_amu}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 13 1 coul/long/SPH_nopseudo_ph 13 1.0 1 minoo 13 150858.7873 0.00054857991

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 minoo

# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/13
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 0.230769230769231

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
fix ele_dyn_wid electron dynamic_widths 1.15 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}
