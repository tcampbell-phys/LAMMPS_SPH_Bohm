variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 512/2.0
variable temptouse equal 11604.5221*${temp_eff}
variable temptouse equal 11604.5221*49.633
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (256/${ion_density})^(1/3)
variable box_len equal (256/0.008928)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 30.6075518993957/2.0

variable dens_wid_const equal 1.3

variable kernel_ave equal ${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable kernel_ave equal 1.3*${box_len}/(${num_electron_elements}^(1/3))
variable kernel_ave equal 1.3*30.6075518993957/(${num_electron_elements}^(1/3))
variable kernel_ave equal 1.3*30.6075518993957/(8192^(1/3))

variable tfwhm equal 4.70964*${kernel_ave}
variable tfwhm equal 4.70964*1.97382494088293

variable sigma_start equal ${kernel_ave}                                         # Start global packet width of electrons in bohr
variable sigma_start equal 1.97382494088293                                         

variable therm_scaling equal 2.306757956602289

### simulation parameters:

variable time_step_length equal 0.1e-3
variable equi_time_steps equal 25199
