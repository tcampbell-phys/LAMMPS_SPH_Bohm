variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable ion_density equal 1.92592592592593*${al_solid_density}  		
variable ion_density equal 1.92592592592593*0.008928  		
variable num_ions equal 1500	                                        # Number of ions
variable ion_charge equal 3.0			                                # Average charge/ionization
variable ion_amu equal 26.982	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 2.9                                         # Start global packet width of electrons in bohr

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electrons equal 1500*${ion_charge}
variable num_electrons equal 1500*3
variable half_num_electrons equal ${num_electrons}/2.0
variable half_num_electrons equal 4500/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable quar_num_electrons equal 2250/2.0
variable temptouse equal 11604.5221*${temp}
variable temptouse equal 11604.5221*3.5
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (1500/${ion_density})^(1/3)
variable box_len equal (1500/0.0171946666666667)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 44.3505659331106/2.0

### simulation parameters:

variable time_step_length equal 0.5e-3
variable equi_time_steps equal 4.0e5
variable data_time_steps equal 2.0e6
variable dump_ts_freq equal 1e4
variable cutoff equal 16.0                                        # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable ion_seed equal 910
variable e_up_a_seed equal 707
variable e_up_b_seed equal 8
variable e_down_a_seed equal 78
variable e_down_b_seed equal 200

# thermostat parameters

variable ion_vel_seed equal 7389
variable e_down_a_vel_seed equal 83671
variable e_down_b_vel_seed equal 12671
variable e_up_a_vel_seed equal 76665
variable e_up_b_vel_seed equal 56665

variable i_temp_damping equal ${time_step_length}*100
variable i_temp_damping equal 0.0005*100
variable e_temp_damping equal ${time_step_length}*10000
variable e_temp_damping equal 0.0005*10000

variable alpha_mass equal 100.0
variable exp_cutoff equal 20.0
variable mu equal 0.641257                                         # ensure chemical potential matches with physical parameters

### NOTE - initialising particles from rest
variable vel_t equal 1.0*${temptouse}
variable vel_t equal 1.0*40615.82735

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 10000
variable rdf_measurement_time_gap equal 10

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 44.3505659331106 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 44.3505659331106 0.0 44.3505659331106 0.0 ${box_len}
region bounding_region block 0.0 44.3505659331106 0.0 44.3505659331106 0.0 44.3505659331106
timestep ${time_step_length}
timestep 0.0005

create_box 2 bounding_region
