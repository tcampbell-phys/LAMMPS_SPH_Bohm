region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 44.3555422733815 0.0 ${box_len} 0.0 ${box_len}
region bounding_region block 0.0 44.3555422733815 0.0 44.3555422733815 0.0 ${box_len}
region bounding_region block 0.0 44.3555422733815 0.0 44.3555422733815 0.0 44.3555422733815
timestep ${time_step_length}
timestep 0.002

create_box 4 bounding_region
