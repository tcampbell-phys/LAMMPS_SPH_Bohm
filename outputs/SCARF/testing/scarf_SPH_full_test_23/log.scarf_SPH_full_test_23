pair_style hybrid/overlay coul/long/SPH_ph 16 1.0 1 3 3 14.5511038506189 filinovt 16 40614 0.00054857991 filinovs 16 40614 ${electron_amu}
pair_style hybrid/overlay coul/long/SPH_ph 16 1.0 1 3 3 14.5511038506189 filinovt 16 40614 0.00054857991 filinovs 16 40614 0.00054857991

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_ph

pair_coeff 2 2 filinovt
pair_coeff 2 3 filinovs
pair_coeff 2 4 filinovt
pair_coeff 3 3 filinovt
pair_coeff 3 4 filinovt
pair_coeff 4 4 filinovt


# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/16
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
kspace_modify gewald 0.1875

fix ele_dyn_wid electrons dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_ph
fix ele_dyn_wid electrons dynamic_widths 1.15 ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_ph
fix ele_dyn_wid electrons dynamic_widths 1.15 1 ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/long/SPH_ph
