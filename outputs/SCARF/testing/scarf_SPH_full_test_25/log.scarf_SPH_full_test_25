variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable box_len equal (1500/${ion_density})^(1/3)
variable box_len equal (1500/0.01718888)^(1/3)
variable half_box_len equal ${box_len}/2.0
variable half_box_len equal 44.3555422733815/2.0

### simulation parameters:

variable time_step_length equal 2.0e-3
variable equi_time_steps equal 5e5
variable data_time_steps equal 1e6
variable dump_ts_freq equal 5e4
variable cutoff equal 16.0                                        # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

