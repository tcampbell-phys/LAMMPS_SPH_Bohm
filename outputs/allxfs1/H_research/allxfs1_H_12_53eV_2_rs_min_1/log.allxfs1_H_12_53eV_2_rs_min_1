  create_atoms CPU = 0.000294589 secs
group electron type 2
4000 atoms in group electron
mass 2 ${element_scaled_mass}
mass 2 6.857248875e-05
set type 2 charge ${element_scaled_charge}
set type 2 charge -0.125
