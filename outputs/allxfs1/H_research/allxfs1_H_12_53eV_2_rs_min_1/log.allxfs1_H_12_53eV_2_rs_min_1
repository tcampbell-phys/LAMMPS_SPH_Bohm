fix ele_dyn_wid electron dynamic_widths 1.15 1 1 2 10 1 bohm_SPH_dynamic_Mocz

fix ele_nvt electron nvt temp ${temptouse} ${temptouse} ${e_temp_damping}
fix ele_nvt electron nvt temp 145381.4528688 ${temptouse} ${e_temp_damping}
fix ele_nvt electron nvt temp 145381.4528688 145381.4528688 ${e_temp_damping}
fix ele_nvt electron nvt temp 145381.4528688 145381.4528688 0.1

### Thermostatting

fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}
fix ion_nvt ion nvt temp 145381.4528688 ${temptouse} ${i_temp_damping}
fix ion_nvt ion nvt temp 145381.4528688 145381.4528688 ${i_temp_damping}
fix ion_nvt ion nvt temp 145381.4528688 145381.4528688 0.1

velocity ion create ${temptouse} ${ion_vel_seed} rot yes dist gaussian
velocity ion create 145381.4528688 ${ion_vel_seed} rot yes dist gaussian
velocity ion create 145381.4528688 46099 rot yes dist gaussian

velocity electron create ${vel_t} ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 145381.4528688 ${e_down_a_vel_seed} rot yes dist gaussian
velocity electron create 145381.4528688 37933 rot yes dist gaussian

