pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 18.261 1 coul/long/SPH_nopseudo_ph 18.261 1.0 1 18.220574835846 sub_minoo 18.261 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 18.261 1 coul/long/SPH_nopseudo_ph 18.261 1.0 1 18.220574835846 sub_minoo 18.261 145381.4528688 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 18.261 1 coul/long/SPH_nopseudo_ph 18.261 1.0 1 18.220574835846 sub_minoo 18.261 145381.4528688 0.00054857991 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 18.261 1 coul/long/SPH_nopseudo_ph 18.261 1.0 1 18.220574835846 sub_minoo 18.261 145381.4528688 0.00054857991 1

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

