variable tfwhm equal 4.70964*1.2*36.0663723540573/(${num_electron_elements}^(1/3))
variable tfwhm equal 4.70964*1.2*36.0663723540573/(1400^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz ${cutoff} ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 18.261 ${gamma_factor} coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 18.261 1 coul/long/SPH_nopseudo_ph ${cutoff} 1.0 1 ${tfwhm} sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
