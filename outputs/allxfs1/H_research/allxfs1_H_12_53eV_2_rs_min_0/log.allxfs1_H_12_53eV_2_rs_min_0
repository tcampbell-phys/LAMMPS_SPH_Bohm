pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 17.5 1 coul/long/SPH_nopseudo_ph 17.5 1.0 1 17.4613842176858 sub_minoo ${cutoff} ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 17.5 1 coul/long/SPH_nopseudo_ph 17.5 1.0 1 17.4613842176858 sub_minoo 17.5 ${temptouse} ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 17.5 1 coul/long/SPH_nopseudo_ph 17.5 1.0 1 17.4613842176858 sub_minoo 17.5 145381.4528688 ${electron_amu} ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 17.5 1 coul/long/SPH_nopseudo_ph 17.5 1.0 1 17.4613842176858 sub_minoo 17.5 145381.4528688 0.00054857991 ${elements_per_electron}
pair_style hybrid/overlay bohm_SPH_dynamic_Mocz 17.5 1 coul/long/SPH_nopseudo_ph 17.5 1.0 1 17.4613842176858 sub_minoo 17.5 145381.4528688 0.00054857991 1

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 2 bohm_SPH_dynamic_Mocz

pair_coeff 2 2 sub_minoo

# kspace
variable ewalds_parameter equal 3/${cutoff}
variable ewalds_parameter equal 3/17.5
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}
