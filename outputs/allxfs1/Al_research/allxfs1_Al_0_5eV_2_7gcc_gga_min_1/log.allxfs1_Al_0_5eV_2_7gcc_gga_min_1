variable compression equal 1.0
variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable ion_density equal 1*${al_solid_density}  		
variable ion_density equal 1*0.008928  		
variable num_ions equal 200	                                        # Number of ions
variable ion_charge equal 3.0			                                # Average charge/ionization
variable ion_amu equal 26.982	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.92                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 8

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_mass equal 0.00054857991/${elements_per_electron}
