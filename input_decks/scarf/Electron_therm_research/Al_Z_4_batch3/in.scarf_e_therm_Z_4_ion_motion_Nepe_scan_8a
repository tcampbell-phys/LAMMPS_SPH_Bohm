### SYSTEM PARAMETERS: 

### physical parameters:

variable temp_eff equal 49.633
variable ion_density equal 0.008928  		# Density in # per bohr^3
variable num_ions equal 216	                                        # Number of ions
variable ion_charge equal 4.0			                                # Average charge/ionization
variable ion_amu equal 26.982	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable elements_per_electron equal 8

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_charge equal -1/${elements_per_electron}

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable half_num_electrons equal ${num_electrons}/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable temptouse equal 11604.5221*${temp_eff}
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable half_box_len equal ${box_len}/2.0

variable dens_wid_const equal 1.3

variable kernel_ave equal ${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))

variable tfwhm equal 4.70964*${kernel_ave}

variable sigma_start equal ${kernel_ave}                                         # Start global packet width of electrons in bohr

variable therm_scaling equal 1.0

### simulation parameters:

variable time_step_length equal 0.025e-3
variable equi_time_steps equal 1000
variable block_time_steps equal 1e2
variable pos_dump_steps equal 100

variable lores_e_dump_ts_freq equal 160
variable pos_e_dump_ts_freq equal 10
variable cutoff equal 1.2*${tfwhm}
variable cutoff_SPH equal 4.5*${kernel_ave}
variable cutoff_Minoo equal 2.38

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH     

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz_rob_ftwo

variable rnseed index 10
variable number equal ceil(random(1,10000000000,${rnseed})/100000.0) # require suffix '-var rnseed $RANDOM'

variable ion_seed equal ${number}
variable e_up_a_seed equal ${number}
variable e_up_b_seed equal ${number}
variable e_down_a_seed equal ${number}
variable e_down_b_seed equal ${number}

# thermostat parameters

variable ion_vel_seed equal ${number}
variable e_down_a_vel_seed equal ${number}
variable e_down_b_vel_seed equal ${number}
variable e_up_a_vel_seed equal ${number}
variable e_up_b_vel_seed equal ${number}

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 10
variable rdf_output_time_step equal 1000
variable rdf_measurement_time_gap equal 10 

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}

lattice fcc 7.652067996490512

timestep ${time_step_length}

create_box 2 bounding_region

create_atoms 1 region bounding_region
group ion type 1
mass 1 ${ion_amu}
set type 1 charge ${ion_charge}

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
group electron type 2
mass 2 ${element_scaled_mass}
set type 2 charge ${element_scaled_charge}

variable tag_ele_start equal ${num_ions}+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable N_iter equal 1
variable mix_fact equal 1.0
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff_SPH} ${type_avoid} ${pair_name}

pair_style hybrid/overlay ${pair_name} ${cutoff_SPH} ${gamma_factor} coul/long/SPH_nopseudo_ph_sub ${cutoff} 1.0 1 ${tfwhm} ${elements_per_electron} ${tag_ele_start} sub_minoo ${cutoff_Minoo} ${temptouse} ${electron_amu} ${elements_per_electron} ${tag_ele_start}

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_nopseudo_ph_sub

pair_coeff 2 2 ${pair_name}

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

# kspace
variable ewalds_parameter equal 3/${cutoff}
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}

### Thermostatting
fix all_nve all nve

velocity ion create 0.0 ${ion_vel_seed} &
rot yes dist gaussian

fix ele_sample_vel electron init_sample_vel ${elements_per_electron} ${therm_scaling} ${e_down_a_vel_seed}

# Compute group temperatures for output in logfile

compute ion_temp ion temp

compute electron_temp electron temp

# Compute pair correlation functions:

compute ion_ion_rdf all rdf ${rdf_num_bins} &
1 1

compute ion_electron_rdf all rdf ${rdf_num_bins} &
1 2

compute electron_electron_rdf all rdf ${rdf_num_bins} &
2 2

fix write_ion_ion_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_ion_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/ele_therm_research/${outputdir}/ion_ion.rdf mode vector

fix write_ion_electron_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_electron_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/ele_therm_research/${outputdir}/ion_electron.rdf mode vector

fix write_electron_electron_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_electron_electron_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/ele_therm_research/${outputdir}/electron_electron.rdf mode vector

# custom logfile output

thermo_style custom step temp c_ion_temp c_electron_temp pe ke etotal press

reset_timestep 0

# Check forces

variable rhi equal 19.36
variable rlo equal 1.001e-2
variable write_N equal 1936

# modify logfile output

thermo_modify lost warn
thermo 50
thermo_style custom step temp c_ion_temp c_electron_temp pe ke etotal press

