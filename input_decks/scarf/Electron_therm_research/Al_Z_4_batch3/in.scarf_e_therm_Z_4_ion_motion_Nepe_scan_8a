fix ele_sample_vel_midrun electron midrun_sample_vel ${elements_per_electron} ${therm_scaling} ${e_down_a_vel_seed}

dump 1 electron custom ${lores_e_dump_ts_freq} /work4/clf/scarf734/LAMMPS/SPH_Bohm/ele_therm_research/${outputdir}/ele_vels_data.dump id vx vy vz

