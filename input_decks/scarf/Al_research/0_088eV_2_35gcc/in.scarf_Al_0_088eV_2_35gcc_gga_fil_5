### SYSTEM PARAMETERS: 

### physical parameters:

variable temp equal 0.088155289		                                        # Temperature in eV
variable al_solid_density equal 0.008928                          # Density in # per bohr^3
variable al_solid_density_gcc equal 2.7                        
variable compression equal 0.87037037
variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable num_ions equal 1500	                                        # Number of ions
variable ion_charge equal 3.0			                                # Average charge/ionization
variable ion_amu equal 26.982	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable num_electrons equal ${num_ions}*${ion_charge}
variable half_num_electrons equal ${num_electrons}/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable temptouse equal 11604.5221*${temp}
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable half_box_len equal ${box_len}/2.0

### simulation parameters:

variable time_step_length equal 1.0e-3
variable equi_time_steps equal 2.0e5
variable ion_data_time_steps equal 1.0e6
variable ele_data_time_steps equal 6.0e3
variable e_dump_ts_freq equal 3
variable dump_ts_freq equal 5e3
variable cutoff equal 18.96                                        # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH     

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable rnseed index 10
variable number equal ceil(random(1,10000000000,${rnseed})/100000.0)

variable ion_seed equal ${number}
variable e_up_a_seed equal ${number}
variable e_up_b_seed equal ${number}
variable e_down_a_seed equal ${number}
variable e_down_b_seed equal ${number}

# thermostat parameters

variable ion_vel_seed equal ${number}
variable e_down_a_vel_seed equal ${number}
variable e_down_b_vel_seed equal ${number}
variable e_up_a_vel_seed equal ${number}
variable e_up_b_vel_seed equal ${number}

variable i_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal ${time_step_length}*10000

variable alpha_mass equal 100.0
variable exp_cutoff equal 20.0
variable mu equal 0.390873                                         # ensure chemical potential matches with physical parameters

### NOTE - initialising particles from rest
variable vel_t equal 1.0*${temptouse}

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 5000
variable rdf_measurement_time_gap equal 10 

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
timestep ${time_step_length}

create_box 5 bounding_region

create_atoms 1 random ${num_ions} ${ion_seed} NULL
group ion type 1
mass 1 ${ion_amu}
set type 1 charge ${ion_charge}

create_atoms 2 random ${quar_num_electrons} ${e_up_a_seed} NULL
group e_up_a type 2
mass 2 ${electron_amu}
set type 2 charge -1.0

create_atoms 3 random ${quar_num_electrons} ${e_down_a_seed} NULL
group e_down_a type 3
mass 3 ${electron_amu}
set type 3 charge -1.0

create_atoms 4 random ${quar_num_electrons} ${e_down_b_seed} NULL
group e_down_b type 4
mass 4 ${electron_amu}
set type 4 charge -1.0

create_atoms 5 random ${quar_num_electrons} ${e_up_b_seed} NULL
group e_up_b type 5
mass 5 ${electron_amu}
set type 5 charge -1.0

group electrons type 2 3 4 5

group e_up type 2 5

group e_down type 3 4

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

variable pseudo_key equal 4

### Dynamic Width fix
variable dens_wid_const equal 0.9
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electrons}^(1/3))
variable sigma_start equal ${dens_wid_const}*${box_len}/(${num_electrons}^(1/3))                                        # Start global packet width of electrons in bohr
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/long/SPH_ph ${cutoff} 1.0 1 ${pseudo_key} ${ion_charge} ${tfwhm} filinovt ${cutoff} ${temptouse} ${electron_amu} filinovs ${cutoff} ${temptouse} ${electron_amu}

# Set up each pair with the correct styles:

pair_coeff * * coul/long/SPH_ph

pair_coeff 2 2 ${pair_name}
pair_coeff 2 3 ${pair_name}
pair_coeff 2 4 ${pair_name}
pair_coeff 2 5 ${pair_name}
pair_coeff 3 3 ${pair_name}
pair_coeff 3 4 ${pair_name}
pair_coeff 3 5 ${pair_name}
pair_coeff 4 4 ${pair_name}
pair_coeff 4 5 ${pair_name}
pair_coeff 5 5 ${pair_name}

pair_coeff 2 2 filinovt
pair_coeff 2 3 filinovt
pair_coeff 2 4 filinovs
pair_coeff 2 5 filinovt
pair_coeff 3 3 filinovt
pair_coeff 3 4 filinovt
pair_coeff 3 5 filinovs
pair_coeff 4 4 filinovt
pair_coeff 4 5 filinovt
pair_coeff 5 5 filinovt

# kspace
variable ewalds_parameter equal 3/${cutoff}
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}

fix ele_dyn_wid electrons dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}

fix fermi_thermostat electrons fermi_nvt_no_cons ${temptouse} ${alpha_mass} ${electron_amu} ${exp_cutoff} ${mu}

### Thermostatting

fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}

velocity ion create ${temptouse} ${ion_vel_seed} &
rot yes dist gaussian

velocity e_down_a create ${vel_t} ${e_down_a_vel_seed} &
rot yes dist gaussian

velocity e_down_b create ${vel_t} ${e_down_b_vel_seed} &
rot yes dist gaussian

velocity e_up_a create ${vel_t} ${e_up_a_vel_seed} &
rot yes dist gaussian

velocity e_up_b create ${vel_t} ${e_up_b_vel_seed} &
rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# Compute group temperatures for output in logfile

compute ion_temp ion temp

compute e_up_temp e_up temp

compute e_down_temp e_down temp

# Compute pair correlation functions:

compute ion_ion_rdf all rdf ${rdf_num_bins} &
1 1

compute ion_e_up_a_rdf all rdf ${rdf_num_bins} &
1 2

compute ion_e_down_a_rdf all rdf ${rdf_num_bins} &
1 3

compute ion_e_down_b_rdf all rdf ${rdf_num_bins} &
1 4

compute ion_e_up_b_rdf all rdf ${rdf_num_bins} &
1 5

compute e_up_a_e_up_a_rdf all rdf ${rdf_num_bins} &
2 2

compute e_up_a_e_down_a_rdf all rdf ${rdf_num_bins} &
2 3

compute e_up_a_e_down_b_rdf all rdf ${rdf_num_bins} &
2 4

compute e_up_a_e_up_b_rdf all rdf ${rdf_num_bins} &
2 5

compute e_down_a_e_down_a_rdf all rdf ${rdf_num_bins} &
3 3

compute e_down_a_e_down_b_rdf all rdf ${rdf_num_bins} &
3 4

compute e_down_a_e_up_b_rdf all rdf ${rdf_num_bins} &
3 5

compute e_down_b_e_down_b_rdf all rdf ${rdf_num_bins} &
4 4

compute e_down_b_e_up_b_rdf all rdf ${rdf_num_bins} &
4 5

compute e_up_b_e_up_b_rdf all rdf ${rdf_num_bins} &
5 5

fix write_ion_ion_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_ion_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/Al_research/${outputdir}/ion_ion.rdf mode vector

fix write_ion_e_up_a_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_e_up_a_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/Al_research/${outputdir}/ion_e_up_a.rdf mode vector

fix write_ion_e_up_b_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_e_up_b_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/Al_research/${outputdir}/ion_e_up_b.rdf mode vector

fix write_ion_e_down_a_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_e_down_a_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/Al_research/${outputdir}/ion_e_down_a.rdf mode vector

