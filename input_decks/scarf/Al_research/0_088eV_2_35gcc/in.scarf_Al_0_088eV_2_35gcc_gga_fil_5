${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_e_down_b_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/Al_research/${outputdir}/ion_e_down_b.rdf mode vector

fix write_e_up_a_e_down_a_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_e_up_a_e_down_a_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/Al_research/${outputdir}/e_up_a_e_down_a.rdf mode vector

