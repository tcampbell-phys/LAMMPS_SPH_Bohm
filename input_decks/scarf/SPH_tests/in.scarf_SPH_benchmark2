### SYSTEM PARAMETERS: 

### physical parameters:

variable temp equal 3.5		                                        # Temperature in eV
variable al_solid_density equal 0.00899                             # Density in # per bohr^3
variable compression equal 1.912
variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable num_ions equal 1000	                                    # Number of ions
variable ion_charge equal 3			                                # Average charge/ionization
variable ion_amu equal 26.982		                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma equal 4.0                                      # Global packet width of electrons in bohr

variable num_electrons equal ${num_ions}*${ion_charge}
variable half_num_electrons equal ${num_electrons}/2.0
variable temptouse equal 11604*${temp}
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable half_box_len equal ${box_len}/2.0

### simulation parameters:

variable time_step_length equal 2.5e-4
variable equil_time_steps equal 2e6
variable data_time_steps equal 2e6
variable cutoff equal 15.377                                        # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style charge                                                   

variable e_up_seed equal 707
variable e_down_seed equal 78

# thermostat parameters

variable al_vel_seed equal 7389
variable e_down_vel_seed equal 83671
variable e_up_vel_seed equal 76665

variable i_temp_damping equal ${time_step_length}*1000

variable alpha_mass equal 200.0
variable exp_cutoff equal 20.0
variable mu equal 0.64125                                           # ensure chemical potential matches with physical parameters

variable vel_t equal 2.4*${temptouse}

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 10000
variable rdf_measurement_time_gap equal 10 

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
timestep ${time_step_length}

create_box 2 bounding_region

create_atoms 1 random ${half_num_electrons} ${e_up_seed} NULL
group e_up type 1
mass 1 ${electron_amu}
set type 1 charge -1.0

create_atoms 2 random ${half_num_electrons} ${e_down_seed} NULL
group e_down type 2
mass 2 ${electron_amu}
set type 2 charge -1.0

group electrons type 1 2

variable bitmap_N equal 15

pair_style hybrid/overlay table bitmap ${bitmap_N} bohm_SPH_basic ${cutoff} ${sigma} ${gamma_factor}

pair_coeff * * bohm_global

pair_coeff 1 1 table ${pauli_table} FORCE_TABLE
pair_coeff 2 2 table ${pauli_table} FORCE_TABLE

pair_coeff 1 2 table zero.table FORCE_TABLE

### Thermostatting

fix e_down_thermostat e_down fermi_nvt_no_cons ${temptouse} ${box_len} ${alpha_mass} 0.0005485799 ${exp_cutoff} ${mu}
velocity e_down create ${vel_t} ${e_down_vel_seed} &
rot yes dist gaussian

fix e_up_thermostat e_up fermi_nvt_no_cons ${temptouse} ${box_len} ${alpha_mass} 0.0005485799 ${exp_cutoff} ${mu}
velocity e_up create ${vel_t} ${e_up_vel_seed} &
rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# Compute group temperatures for output in logfile

compute e_up_temp e_up temp

compute e_down_temp e_down temp

# Compute group KEs for output in logfile

compute e_up_ke e_up ke

compute e_down_ke e_down ke

# Compute pair correlation functions:

compute e_up_e_up_rdf all rdf ${rdf_num_bins} &
1 1

compute e_up_e_down_rdf all rdf ${rdf_num_bins} &
1 2

compute e_down_e_down_rdf all rdf ${rdf_num_bins} &
2 2

fix write_e_up_e_down_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_e_up_e_down_rdf[*] file &
/work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/e_up_e_down.rdf mode vector

fix write_e_up_e_up_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_e_up_e_up_rdf[*] file &
/work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/e_up_e_up.rdf mode vector

fix write_e_down_e_down_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_e_down_e_down_rdf[*] file &
/work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/e_down_e_down.rdf mode vector

# custom logfile output

thermo_style custom step temp c_e_up_temp c_e_down_temp pe ke etotal press

# Minimize energy

min_style cg
minimize 1.0e-2 1.0e-3 1000 10000 

reset_timestep 0

# Check forces

variable rhi equal 19.0
variable rlo equal 1.001e-2
variable write_N equal 1900

pair_write 1 1 ${write_N} r ${rlo} ${rhi} /work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/out_table_e_up_e_up.txt FORCE_TABLE
pair_write 1 2 ${write_N} r ${rlo} ${rhi} /work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/out_table_e_up_e_down.txt FORCE_TABLE
pair_write 2 2 ${write_N} r ${rlo} ${rhi} /work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/out_table_e_down_e_down.txt FORCE_TABLE

# modify logfile output

thermo_modify lost warn
thermo 100
thermo_style custom step temp c_e_up_temp c_e_down_temp pe ke etotal press

# dump all_particles_track_equil all custom 500 /work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/all_equil.dump id type fx fy fz x y z

run ${equil_time_steps}

unfix e_up_thermostat
unfix e_down_thermostat

fix all_nve all nve

# dump all_particles_track_data all custom 500 /work4/clf/scarf734/LAMMPS/Bohm_Global/${outputdir}/all_data.dump id type fx fy fz x y z

run ${data_time_steps}

quit 0