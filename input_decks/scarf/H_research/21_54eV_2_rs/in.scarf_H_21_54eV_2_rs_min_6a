### SYSTEM PARAMETERS: 

### physical parameters:

variable temp equal 21.54	         # temperature in Ev
variable ion_density equal 0.02981476  		# Density in # per bohr^3
variable num_ions equal 256	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.32                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 32

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_charge equal -1/${elements_per_electron}

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable half_num_electrons equal ${num_electrons}/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable temptouse equal 11604.5221*${temp}
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable half_box_len equal ${box_len}/2.0

variable confine_strength equal 0.168        # set strength of qudratic confinement potential for SPH elements belonging to the same electron

### simulation parameters:

variable time_step_length equal 0.1e-3
variable block_time_steps equal 1.6e5
variable CoM_check_time_steps equal 2000
variable CoM_freq equal 10
variable data_block_time_steps equal 5.9997e5
variable e_dump_ts_freq equal 70
variable cutoff equal 7.15                                  # cutoff for pairwise calculations
variable cutoff_SPH equal 5.281
variable cutoff_Minoo equal 3.743

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH_CoM     

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable rnseed index 10
variable number equal ceil(random(1,10000000000,${rnseed})/100000.0)

variable ion_seed equal ${number}
variable e_up_a_seed equal ${number}
variable e_up_b_seed equal ${number}
variable e_down_a_seed equal ${number}
variable e_down_b_seed equal ${number}

# thermostat parameters

variable ion_vel_seed equal ${number}
variable e_down_a_vel_seed equal ${number}
variable e_down_b_vel_seed equal ${number}
variable e_up_a_vel_seed equal ${number}
variable e_up_b_vel_seed equal ${number}

variable i_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal ${time_step_length}*200
                                     
variable vel_t equal 1.0*${temptouse}

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 4000
variable rdf_measurement_time_gap equal 10 

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
timestep ${time_step_length}

create_box 2 bounding_region

create_atoms 1 random ${num_ions} ${ion_seed} NULL
group ion type 1
mass 1 ${ion_amu}
set type 1 charge ${ion_charge}

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
group electron type 2
mass 2 ${element_scaled_mass}
set type 2 charge ${element_scaled_charge}

variable tag_ele_start equal ${num_ions}+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 1
variable mix_fact equal 1.0
variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix ele_dyn_wid electron dynamic_widths_com_ftwo ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff_SPH} ${box_len} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${pair_name}

pair_style hybrid/overlay ${pair_name} ${cutoff_SPH} ${gamma_factor} coul/long ${cutoff} sub_minoo ${cutoff_Minoo} ${temptouse} ${electron_amu} ${elements_per_electron} ${tag_ele_start}

# Set up each pair with the correct styles:

pair_coeff * * coul/long

pair_coeff 2 2 ${pair_name}

pair_coeff 2 2 sub_minoo

# increase number of allowed neighbours
neigh_modify one 10000

# kspace
variable ewalds_parameter equal 3/${cutoff}
kspace_style ewald 1.0e-4
kspace_modify gewald ${ewalds_parameter}

### Thermostatting
fix ele_nve electron nve
fix ion_nvt ion nvt temp ${temptouse} ${temptouse} ${i_temp_damping}

velocity ion create ${temptouse} ${ion_vel_seed} &
rot yes dist gaussian

velocity electron create ${vel_t} ${e_down_a_vel_seed} &
rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# Compute group temperatures for output in logfile

compute ion_temp ion temp

compute electron_temp electron temp

# Compute pair correlation functions:

compute ion_ion_rdf all rdf ${rdf_num_bins} &
1 1

compute ion_electron_rdf all rdf ${rdf_num_bins} &
1 2

compute electron_electron_rdf all rdf ${rdf_num_bins} &
2 2

fix write_ion_ion_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
