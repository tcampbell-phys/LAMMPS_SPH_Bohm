### SYSTEM PARAMETERS: 

### physical parameters:

variable temp equal 0.000	         # temperature in eV
variable num_ions equal 1	                                        # Number of ions
variable ion_charge equal 1.0			                                # Average charge/ionization
variable ion_amu equal 1.008	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 0.9                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 1237 # must match number of elements generated on lattice

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_charge equal -1/${elements_per_electron}

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable temptouse equal 11604.5221*${temp}

### simulation parameters:

variable radius equal 2.5
variable cutoff equal 5.0  # cutoff for pairwise calculations

variable assign_ion equal 1    # if set to 1, all ions moved to targ coord on first timestep
variable targ_coord equal 0.0

variable lattice_const equal 0.375 # tune lattice constant so that number of atoms produced equals elements_per_electron (for accurate mass and charge values)

units electron                                                      # use electron units (Hartree)
newton on
boundary s s s
atom_style SPH_CoM   

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_doubtwo_rob_ftwo_fix

variable ion_seed equal 99919
variable e_up_a_seed equal 25132
variable e_up_b_seed equal 79840
variable e_down_a_seed equal 21611
variable e_down_b_seed equal 99020

# thermostat parameters

variable ion_vel_seed equal 12964
variable e_down_a_vel_seed equal 85890
variable e_down_b_vel_seed equal 66097
variable e_up_a_vel_seed equal 13720
variable e_up_b_vel_seed equal 31943
                                     
variable vel_t equal 1.0*${temptouse}

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 10
variable rdf_output_time_step equal 4000
variable rdf_measurement_time_gap equal 1 

### Setup simulation

region bounding_region sphere 0.0 0.0 0.0 ${radius} units box

lattice sc ${lattice_const} origin 0.0 0.0 0.0

create_box 2 bounding_region

create_atoms 1 random ${num_ions} ${ion_seed} NULL
group ion type 1
mass 1 ${ion_amu}
set type 1 charge ${ion_charge}

create_atoms 2 region bounding_region
group electron type 2
mass 2 ${element_scaled_mass}
set type 2 charge ${element_scaled_charge}

variable tag_ele_start equal ${num_ions}+1

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 8
variable mix_fact equal 1.0
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

# Call dynamic_widths_com to ensure calculation of electron Centres of Mass

fix Bohm_Pot electron dynamic_widths_com_bp_doubtwo_rob_ftwo ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${radius} ${type_avoid} ${num_electrons} ${elements_per_electron} ${tag_ele_start} ${gamma_factor} ${pair_name}
fix_modify Bohm_Pot energy yes

# set large 'elements_per_electron' argument to coul/cut/SPH_nopseudo_sub to ensure no electron - electron self interaction

pair_style hybrid/overlay ${pair_name} ${cutoff} ${gamma_factor} coul/cut/SPH_nopseudo_sub ${cutoff} 1.0 1 10000 ${tag_ele_start} ${assign_ion} ${targ_coord}

# Set up each pair with the correct styles:

pair_coeff * * coul/cut/SPH_nopseudo_sub

pair_coeff 2 2 ${pair_name}

# increase number of allowed neighbours
neigh_modify one 10000

velocity all create ${temptouse} ${ion_vel_seed} &
rot yes dist gaussian

variable thermo_freq equal 10

compute all_momentum all momentum

fix write_all_momentum all ave/time &
1 1 ${thermo_freq} &
c_all_momentum[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/ground/${outputdir}/all_momentum.out mode vector

# Randomize the starting positions of all of our particles

displace_atoms all random 0.005 0.005 0.005 42

compute electron_temp electron temp

# Compute pair correlation functions:
compute ion_electron_rdf all rdf ${rdf_num_bins} &
1 2

compute electron_electron_rdf all rdf ${rdf_num_bins} &
2 2

fix write_ion_electron_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_ion_electron_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/ground/${outputdir}/ion_electron.rdf mode vector

fix write_electron_electron_rdf all ave/time &
${rdf_measurement_time_gap} ${rdf_num_measurements} ${rdf_output_time_step} &
c_electron_electron_rdf[*] file &
/work4/clf/scarf734/LAMMPS/SPH_Bohm/ground/${outputdir}/electron_electron.rdf mode vector

# custom logfile output

thermo_style custom step temp pe ke etotal press

# modify logfile output

thermo_modify lost warn
thermo ${thermo_freq}
thermo_style custom step temp pe ke etotal press

fix all_nve all nve

variable equi_time_steps equal 40000.0

variable CoM_check_time_steps equal 25

variable dump_freq equal 1

variable time_step_length equal 5e-07

timestep ${time_step_length}

### stage 0
run ${equi_time_steps}

dump 0 ion xyz ${dump_freq} /work4/clf/scarf734/LAMMPS/SPH_Bohm/ground/${outputdir}/ion_xyz_data_check0.dump

dump 1 electron custom ${dump_freq} /work4/clf/scarf734/LAMMPS/SPH_Bohm/ground/${outputdir}/ele_xyzh_data_check0.dump id x y z width_SPH x_COM y_COM z_COM vx vy vz

run ${CoM_check_time_steps}

undump 0

undump 1

quit 0

