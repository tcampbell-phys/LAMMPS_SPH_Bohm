# Set output directory

variable out_number string 39

### BACKUP SIMULATION FILES

# CAREFUL - check pauli_table gamma coefficient matches gamma_factor input

variable gamma_factor equal 1.0

variable outputdir string hedp_SPH_dynamic_bohm_${out_number}
shell mkdir /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/
shell cp ~/fresh_lammps-3Mar20/lammps-3Mar20/SPH_Bohm/in.hedp_SPH_dynamic_bohm_${out_number} /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/
shell cp ~/fresh_lammps-3Mar20/lammps-3Mar20/src/pair_bohm_SPH_dynamic.cpp /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/
shell cp ~/fresh_lammps-3Mar20/lammps-3Mar20/src/pair_bohm_SPH_dynamic.h /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/
log /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/log.${outputdir}  

### SYSTEM PARAMETERS: 

### physical parameters:

variable temp equal 3.5		                                        # Temperature in eV
variable al_solid_density equal 0.00899                             # Density in # per bohr^3
variable compression equal 1.912
variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable num_ions equal 500	                                        # Number of ions
variable ion_charge equal 3			                                # Average charge/ionization
variable ion_amu equal 26.982		                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.5                                         # Start global packet width of electrons in bohr

variable num_electrons equal ${num_ions}*${ion_charge}
variable half_num_electrons equal ${num_electrons}/2.0
variable temptouse equal 11604*${temp}
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable half_box_len equal ${box_len}/2.0

### simulation parameters:

variable time_step_length equal 1e-2
variable data_time_steps equal 1e5
variable dump_ts_freq equal 1000000
variable cutoff equal 15.0                                          # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH     

# Pair style string selection

variable pair_name string bohm_SPH_dynamic_Mocz

variable al_seed equal 910
variable e_up_seed equal 707
variable e_down_seed equal 78

# thermostat parameters

variable al_vel_seed equal 7389
variable e_down_vel_seed equal 83671
variable e_up_vel_seed equal 76665

variable i_temp_damping equal ${time_step_length}*1000

variable alpha_mass equal 200.0
variable exp_cutoff equal 20.0
variable mu equal 0.64125                                           # ensure chemical potential matches with physical parameters

### NOTE - initialising particles from rest
variable vel_t equal 0.0*${temptouse}

# rdf calculation

variable rdf_num_bins equal 150
variable rdf_num_measurements equal 100
variable rdf_output_time_step equal 5000
variable rdf_measurement_time_gap equal 10 

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
timestep ${time_step_length}

create_box 2 bounding_region

create_atoms 1 random ${half_num_electrons} ${e_up_seed} NULL
group e_up type 1
mass 1 ${electron_amu}
set type 1 charge -1.0

create_atoms 2 random ${half_num_electrons} ${e_down_seed} NULL
group e_down type 2
mass 2 ${electron_amu}
set type 2 charge -1.0

variable bitmap_N equal 15

pair_style ${pair_name} ${cutoff} ${gamma_factor}

# Set up each pair with the correct styles:

pair_coeff * *

variable ewalds_parameter equal 4.242640687/${box_len}

### Dynamic Width fix
variable dens_wid_const equal 1.3
variable N_iter equal 1
variable mix_fact equal 0.4
variable type_avoid equal 10 #ensure ions are not included in SPH loops (must match ion type)

fix all_dyn_wid all dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} ${pair_name}

### Thermostatting

fix all_nve all nve

velocity e_down create ${vel_t} ${e_down_vel_seed} &
rot yes dist gaussian

velocity e_up create ${vel_t} ${e_up_vel_seed} &
rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# Compute group temperatures for output in logfile

compute e_up_temp e_up temp

compute e_down_temp e_down temp

# Compute group KEs for output in logfile

compute e_up_ke e_up ke

compute e_down_ke e_down ke

# Ensure ghost atom velocities communicated for SPH Bohm Potential:

comm_modify vel yes

# Compute pair correlation functions:

# custom logfile output

thermo_style custom step temp c_e_up_temp c_e_down_temp pe ke etotal press

# Minimize energy

# min_style cg
# minimize 1.0e-4 1.0e-5 1000 10000 

reset_timestep 0

# Check forces

variable rhi equal 19.36
variable rlo equal 1.001e-2
variable write_N equal 1936

# modify logfile output

thermo_modify lost warn
thermo 10
thermo_style custom step temp c_e_up_temp c_e_down_temp pe ke etotal press

#dump 1 all custom ${dump_ts_freq} /data/tcampbell/LAMMPS/SPH_Bohm/${outputdir}/all_data.dump id type fx fy fz x y z rho_SPH width_SPH omega_SPH u_SPH vx vy vz
#dump_modify 1 format line "%d %d %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f"
run ${data_time_steps}

quit 0