variable outputdir string allxfs1_coul_testing_${out_number}
shell mkdir /data/gregori/campbellt/LAMMPS/SPH_Bohm/coul_testing/${outputdir}/
shell cp ~/fresh-lammps/lammps-3Mar20/coul_testing/in.${outputdir} /data/gregori/campbellt/LAMMPS/SPH_Bohm/coul_testing/${outputdir}/
shell cp ~/fresh-lammps/lammps-3Mar20/src/pair_coul_long_SPH_ph.cpp /data/gregori/campbellt/LAMMPS/SPH_Bohm/coul_testing/${outputdir}/
shell cp ~/fresh-lammps/lammps-3Mar20/src/pair_coul_long_SPH_ph.h /data/gregori/campbellt/LAMMPS/SPH_Bohm/coul_testing/${outputdir}/
log /data/gregori/campbellt/LAMMPS/SPH_Bohm/coul_testing/${outputdir}/log.${outputdir}  

### SYSTEM PARAMETERS: 

### physical parameters:

variable temp equal 3.5		                                        # Temperature in eV
variable al_solid_density equal 0.008928                          # Density in # per bohr^3
variable al_solid_density_gcc equal 2.7                        
variable compression equal 5.2/${al_solid_density_gcc}
variable ion_density equal ${compression}*${al_solid_density}  		# Density in # per bohr^3
variable num_ions equal 2	                                        # Number of ions
variable ion_charge equal 3.0			                                # Average charge/ionization
variable ion_amu equal 26.982	                                # Atomic mass of ion
variable electron_amu equal 0.00054857991                           # Atomic mass of electrons

variable sigma_start equal 1.0e-3                                         # Start global packet width of electrons in bohr

variable elements_per_electron equal 1.0

variable element_scaled_mass equal ${electron_amu}/${elements_per_electron}
variable element_scaled_charge equal -1/${elements_per_electron}

variable num_electrons equal ${num_ions}*${ion_charge}
variable num_electron_elements equal ${num_electrons}*${elements_per_electron}
variable half_num_electrons equal ${num_electrons}/2.0
variable quar_num_electrons equal ${half_num_electrons}/2.0
variable temptouse equal 11604.5221*${temp}
variable box_len equal (${num_ions}/${ion_density})^(1/3)
variable half_box_len equal ${box_len}/2.0

### simulation parameters:

variable time_step_length equal 0.5e-3
variable equi_time_steps equal 0
variable dump_ts_freq equal 1
variable cutoff equal 3.8                                        # cutoff for pairwise calculations

units electron                                                      # use electron units (Hartree)
newton on
boundary p p p
atom_style SPH

variable ion_seed equal 7591336
variable e_up_a_seed equal 9111840416
variable e_up_b_seed equal 2031551537
variable e_down_a_seed equal 4681168369
variable e_down_b_seed equal 8529103287

# thermostat parameters

variable ion_vel_seed equal 6709213
variable e_down_a_vel_seed equal 8819515683
variable e_down_b_vel_seed equal 8337206329
variable e_up_a_vel_seed equal 6474829605
variable e_up_b_vel_seed equal 3089118264

variable i_temp_damping equal ${time_step_length}*100
variable e_temp_damping equal ${time_step_length}*10000

### NOTE - initialising particles from rest
variable vel_t equal 1.0*${temptouse}

### Setup simulation

region bounding_region block 0.0 ${box_len} 0.0 ${box_len} 0.0 ${box_len}
timestep ${time_step_length}

create_box 2 bounding_region

create_atoms 1 random ${num_ions} ${ion_seed} NULL
group ion type 1
mass 1 ${ion_amu}
set type 1 charge ${ion_charge}

create_atoms 2 random ${num_electron_elements} ${e_up_a_seed} NULL
group electron type 2
mass 2 ${element_scaled_mass}
set type 2 charge ${element_scaled_charge}

comm_modify vel yes

### Dynamic Width fix
variable dens_wid_const equal 1.15
variable N_iter equal 1
variable mix_fact equal 0.0
### variable tfwhm equal 4.70964*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable tfwhm equal 0.0*${dens_wid_const}*${box_len}/(${num_electron_elements}^(1/3))
variable type_avoid equal 1 #ensure ions are not included in SPH loops (must match ion type)

variable bitmap_N equal 15

pair_style hybrid/overlay coul/cut ${cutoff} table bitmap ${bitmap_N}

# Set up each pair with the correct styles:

pair_coeff 1 1 coul/cut

pair_coeff 1 2 table ${pseudo_table_name} FORCE_TABLE

pair_coeff 2 2 coul/cut

fix ele_dyn_wid electron dynamic_widths ${dens_wid_const} ${N_iter} ${mix_fact} ${sigma_start} ${cutoff} ${type_avoid} coul/cut

### Thermostatting

fix all_nve all nve

velocity ion create ${temptouse} ${ion_vel_seed} &
rot yes dist gaussian

velocity electron create ${vel_t} ${e_down_a_vel_seed} &
rot yes dist gaussian

# Randomize the starting positions of all of our particles

displace_atoms all random 0.1 0.1 0.1 42

# Compute group temperatures for output in logfile

compute ion_temp ion temp

compute electron_temp electron temp

# custom logfile output

thermo_style custom step temp c_ion_temp c_electron_temp pe ke etotal press

# modify logfile output

thermo_modify lost warn
thermo 1
thermo_style custom step temp c_ion_temp c_electron_temp pe ke etotal press

dump 1 all custom ${dump_ts_freq} /data/gregori/campbellt/LAMMPS/SPH_Bohm/coul_testing/${outputdir}/all_data.dump id type fx fy fz x y z rho_SPH width_SPH omega_SPH u_SPH vx vy vz
dump_modify 1 format line "%d %d %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f %16.16f"
run ${equi_time_steps}

quit 0